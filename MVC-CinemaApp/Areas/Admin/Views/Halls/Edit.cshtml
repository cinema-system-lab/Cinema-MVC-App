@using Core.Enums
@using Microsoft.AspNetCore.Mvc.Rendering
@model Core.DTOs.HallDTO
@{
    ViewData["Title"] = "Edit Hall";
    var seats = ViewBag.Seats as List<Core.DTOs.SeatDTO> ?? new List<Core.DTOs.SeatDTO>();
}

<link rel="stylesheet" href="~/css/admin-base.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/admin-hall.css" asp-append-version="true"/>

<div class="container-fluid py-4">
    <div class="mb-4 d-flex justify-content-between align-items-end">
        <div>
            <h2 class="fw-bold m-0 text-white">Edit Cinema Hall</h2>
            <p class="text-muted small m-0">Update hall configuration and manage seating layout</p>
        </div>
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left"></i> Back to Halls
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4 col-md-5">
            <div class="edit-card mb-4">
                <h5 class="section-title">
                    <i class="bi bi-info-circle me-2 text-primary"></i>Hall Information
                </h5>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger shadow-sm mb-4 border-0 text-start">
                        <div asp-validation-summary="ModelOnly" class="small fw-bold"></div>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger shadow-sm mb-4 border-0 text-start small">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Hall Name</label>
                        <div class="input-group">
                            <span class="input-group-text text-primary">
                                <i class="bi bi-door-closed"></i>
                            </span>
                            <input asp-for="Name" class="form-control"/>
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Type" class="form-label">Hall Type</label>
                        <div class="input-group">
                            <span class="input-group-text text-primary">
                                <i class="bi bi-badge-3d"></i>
                            </span>
                            <select asp-for="Type" class="form-control" id="hallTypeSelect">
                                @foreach (HallType hallType in Enum.GetValues(typeof(HallType))) {
                                    <option value="@hallType">@hallType</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn-action btn-save shadow-sm mb-2">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn-action btn-cancel">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </form>
            </div>

            <div class="stats-card">
                <h6 class="text-white fw-bold mb-3">
                    <i class="bi bi-bar-chart me-2 text-primary"></i>Quick Stats
                </h6>
                <div class="stat-item">
                    <span class="stat-label">
                        <i class="bi bi-grid-3x3-gap"></i> Total Seats
                    </span>
                    <span class="stat-value">@ViewBag.SeatsCount</span>
                </div>
                @if (seats.Any()) {
                    var regularCount = seats.Count(s => s.Type == SeatType.Regular);
                    var premiumCount = seats.Count(s => s.Type == SeatType.Premium);
                    <div class="stat-item">
                        <span class="stat-label">
                            <i class="bi bi-bookmark"></i> Regular Seats
                        </span>
                        <span class="stat-value text-success">@regularCount</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">
                            <i class="bi bi-star"></i> Premium Seats
                        </span>
                        <span class="stat-value text-warning">@premiumCount</span>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-8 col-md-7">
            <div class="edit-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="section-title mb-0" style="border: none; padding: 0;">
                        <i class="bi bi-grid-3x3 me-2 text-primary"></i>Seat Layout
                    </h5>
                    @if (seats.Any()) {
                        <a asp-controller="Seats" asp-action="Index" asp-route-hallId="@Model.Id"
                           class="btn-action btn-edit-seats"
                           style="width: auto; padding: 8px 16px; font-size: 0.85rem;">
                            <i class="bi bi-pencil-square"></i> Edit Layout
                        </a>
                    }
                </div>

                @if (seats.Any()) {
                    <div class="screen-element">SCREEN</div>

                    <div class="seat-grid">
                        <div class="d-flex flex-column align-items-center">
                            @foreach (var rowGroup in seats.GroupBy(x => x.RowNumber).OrderBy(x => x.Key)) {
                                var maxSeatInRow = rowGroup.Max(x => x.SeatNumber);
                                <div class="d-flex mb-2 align-items-center">
                                    <div class="row-label">Row @rowGroup.Key</div>
                                    @for (byte i = 1; i <= maxSeatInRow; i++) {
                                        var seat = rowGroup.FirstOrDefault(x => x.SeatNumber == i);
                                        if (seat != null) {
                                            <div
                                                class="seat @(seat.Type == SeatType.Premium ? "seat-premium" : "seat-regular")">
                                                @seat.SeatNumber
                                            </div>
                                        } else {
                                            <div style="width: 28px; height: 28px; margin: 0 2px;"></div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="legend">
                        <div class="legend-item">
                            <div class="legend-box seat-regular"></div>
                            <span>Regular Seats</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-box seat-premium"></div>
                            <span>Premium Seats</span>
                        </div>
                    </div>
                } else {
                    <div class="empty-state">
                        <i class="bi bi-grid-3x3-gap d-block"></i>
                        <h5 class="text-white mb-2">No Seats Configured</h5>
                        <p class="text-muted mb-4">This hall doesn't have any seats set up yet.</p>
                        <a asp-controller="Seats" asp-action="Index" asp-route-hallId="@Model.Id"
                           class="btn-action btn-save" style="width: auto; padding: 10px 20px;">
                            <i class="bi bi-plus-circle"></i> Configure Seats
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/hall-form.js" asp-append-version="true"></script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}