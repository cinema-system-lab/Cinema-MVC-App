@using Microsoft.AspNetCore.Mvc.Rendering
@using Core.Enums
@model Core.DTOs.MovieDTO

@{
    ViewData["Title"] = "Add New Movie";
}

<link rel="stylesheet" href="~/css/admin-base.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/admin-movie.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/admin-tmdb.css" asp-append-version="true"/>

<div class="container py-5">
    <div class="mb-4 d-flex justify-content-between align-items-end">
        <div>
            <h2 class="fw-bold m-0 text-white">Add New Movie</h2>
            <p class="text-muted small m-0">Register a new title in the cinema catalog</p>
        </div>
        <a asp-action="Index" class="text-muted small text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Library
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Create Movie</h2>
        <button type="button" class="btn-action btn-save shadow-sm" data-bs-toggle="modal" data-bs-target="#tmdbModal">
            <i class="bi bi-cloud-download"></i> Import from TMDB
        </button>
    </div>

    <div class="create-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <div class="row g-4">
                <div class="col-lg-3 col-md-4">
                    <label class="form-label">Poster Preview</label>
                    <div class="poster-preview-box" id="posterPreview">
                        <i class="bi bi-image text-muted fs-1"></i>
                    </div>
                </div>

                <div class="col-lg-9 col-md-8">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="section-title"><i class="bi bi-info-circle me-2 text-success"></i>General Info
                            </h5>

                            <div class="mb-3">
                                <label asp-for="Title" class="form-label">Movie Title</label>
                                <input asp-for="Title" class="form-control" placeholder="e.g. Inception"/>
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Director" class="form-label"></label>
                                <input asp-for="Director" class="form-control" placeholder="e.g. Christopher Nolan"/>
                                <span asp-validation-for="Director" class="text-danger small"></span>
                            </div>

                            <div class="row">
                                <div class="col-6">
                                    <div class="mb-3">
                                        <label asp-for="ReleaseDate" class="form-label">Release Date</label>
                                        <input asp-for="ReleaseDate" type="date" class="form-control"/>
                                        <span asp-validation-for="ReleaseDate" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="mb-3">
                                        <label asp-for="DurationMinutes" class="form-label">Minutes</label>
                                        <input asp-for="DurationMinutes" class="form-control" type="number"
                                               placeholder="152"/>
                                        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Rating" class="form-label">Critic Rating (0-10)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent border-end-0 text-warning"
                                          style="border-color: var(--admin-border)">
                                        <i class="bi bi-star-fill"></i>
                                    </span>
                                    <input asp-for="Rating" class="form-control border-start-0 rounded-end"
                                           type="number" step="0.1" id="ratingInput"/>
                                </div>
                                <span asp-validation-for="Rating" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5 class="section-title"><i class="bi bi-tags me-2 text-success"></i>Classification & Media
                            </h5>

                            <div class="mb-3">
                                <label class="form-label">Genres</label>
                                <select name="selectedGenres" id="genresSelect" class="form-select" multiple="multiple">
                                    @foreach (GenreType genre in Enum.GetValues(typeof(GenreType))) {
                                        if (genre == GenreType.None) continue;

                                        if (Model.Genres.HasFlag(genre)) {
                                            <option value="@((int)genre)" selected="selected">@genre.ToString()</option>
                                        } else {
                                            <option value="@((int)genre)">@genre.ToString()</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="AgeRestriction" class="form-label">Age Restriction</label>
                                <input asp-for="AgeRestriction" type="number" class="form-control" placeholder="12"/>
                                <span asp-validation-for="AgeRestriction" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="PosterUrl" class="form-label">Poster URL</label>
                                <input asp-for="PosterUrl" class="form-control" id="posterUrlInput"
                                       placeholder="https://image-link.jpg"/>
                                <span asp-validation-for="PosterUrl" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="TrailerUrl" class="form-label">Trailer Link (YouTube)</label>
                                <input asp-for="TrailerUrl" class="form-control" placeholder="https://youtube.com/..."/>
                            </div>

                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeSwitch"
                                       checked>
                                <label class="form-check-label text-white" for="activeSwitch">Available for
                                    Booking</label>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-12">
                            <h5 class="section-title"><i class="bi bi-card-text me-2 text-success"></i>Content</h5>

                            <div class="mb-4">
                                <label asp-for="Actors" class="form-label">Main Cast</label>
                                <input asp-for="Actors" class="form-control"
                                       placeholder="Leonardo DiCaprio, Elliot Page..."/>
                                <span asp-validation-for="Actors" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Description" class="form-label">Plot Summary</label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn-action btn-create shadow-sm">
                    <i class="bi bi-plus-circle"></i> Create Movie
                </button>
                <a asp-action="Index" class="btn-action btn-cancel">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="tmdbModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content admin-modal-content">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h4 class="modal-title fw-bold text-white">Import from TMDB</h4>
                    <p class="text-muted small mb-0">Search millions of movies to auto-fill your form</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="tmdb-search-wrapper mb-4">
                    <div class="input-group custom-input-group shadow-sm">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="bi bi-search text-success"></i>
                        </span>
                        <input type="text" id="tmdbSearchInput" class="form-control border-start-0"
                               placeholder="Search movie title (e.g. Interstellar)...">
                        <button class="btn btn-save px-4" type="button" id="btnSearchTmdb">
                            Search
                        </button>
                    </div>
                </div>

                <div id="tmdbResultsList" class="tmdb-results-container custom-scrollbar">
                </div>

                <div id="tmdbLoading" class="text-center d-none py-5">
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted mt-2">Connecting to TMDB...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/movie-form.js"></script>
    <script>
        $(document).ready(function () {
            $('#genresSelect').select2({
                placeholder: "Select at least one genre",
                width: '100%'
            });
            $('#genresSelect').on('change', function () {
                $(this).valid();
            });

            let ratingInput = $('#ratingInput');
            $('#btnSearchTmdb').click(function () {
                performTmdbSearch();
            });

            $('#tmdbSearchInput').keypress(function (e) {
                if (e.which == 13) {
                    performTmdbSearch();
                }
            });

            function performTmdbSearch() {
                var query = $('#tmdbSearchInput').val();
                if (!query) return;

                $('#tmdbResultsList').empty();
                $('#tmdbLoading').removeClass('d-none');

                $.ajax({
                    url: '/Admin/Movies/SearchTmdbJson',
                    data: {query: query},
                    success: function (data) {
                        $('#tmdbLoading').addClass('d-none');
                        if (data.length === 0) {
                            $('#tmdbResultsList').html('<div class="alert alert-warning">Nothing found.</div>');
                            return;
                        }

                        data.forEach(function (movie) {
                            var img = movie.poster
                                ? `<img src="${movie.poster}" class="tmdb-result-img me-3">`
                                : `<div class="tmdb-result-img me-3 d-flex align-items-center justify-content-center bg-dark"><i class="bi bi-film"></i></div>`;

                            var item = `
                                    <a href="/Admin/Movies/CreateFromTmdb?tmdbId=${movie.id}" class="tmdb-result-item d-flex align-items-center">
                                        ${img}
                                        <div class="tmdb-result-info flex-grow-1">
                                            <h6 class="mb-0">${movie.title}</h6>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="badge bg-dark text-warning small">${movie.year}</span>
                                                <span class="text-muted small"><i class="bi bi-star-fill text-warning"></i> ${movie.vote_average || 'N/A'}</span>
                                            </div>
                                            <p class="mb-0 text-truncate" style="max-width: 450px;">${movie.overview || 'No description available.'}</p>
                                        </div>
                                        <div class="ms-3">
                                            <span class="btn btn-sm btn-outline-success rounded-pill px-3">Select</span>
                                        </div>
                                    </a>
                                `;
                            $('#tmdbResultsList').append(item);
                        });
                    },
                    error: function () {
                        $('#tmdbLoading').addClass('d-none');
                        $('#tmdbResultsList').html('<div class="alert alert-danger">Error searching TMDB.</div>');
                    }
                });
            }

            function updatePosterPreview(url) {
                if (url) {
                    $('#posterPreview').html(`<img src="${url}" class="img-fluid rounded shadow" style="width: 100%; height: auto; display: block;" />`);
                }
            }

            updatePosterPreview($('#posterUrlInput').val());

            $('#posterUrlInput').on('input', function () {
                updatePosterPreview($(this).val());
            });
        });
    </script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}