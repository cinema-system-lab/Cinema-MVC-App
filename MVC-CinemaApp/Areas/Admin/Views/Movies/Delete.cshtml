@model Core.DTOs.MovieDTO
@{
    ViewData["Title"] = "Delete Movie";
}

<link rel="stylesheet" href="~/css/admin-movie.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-base.css" asp-append-version="true" />

<div class="container delete-container">
    <div class="delete-card">
        <div class="warning-icon">
            <i class="bi bi-exclamation-octagon"></i>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger shadow-sm mb-4 text-start">
                <div asp-validation-summary="ModelOnly" class="small"></div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger shadow-sm mb-4 text-start small">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        <h3 class="fw-bold text-white mb-2">Confirm Deletion</h3>
        <p class="text-muted mb-4">You are about to permanently remove this record. This action cannot be undone.</p>

        <div class="movie-info-box">
            <span class="text-muted small text-uppercase fw-bold d-block mb-1">Movie Title</span>
            <h4 class="text-white m-0">@Model.Title</h4>
            <div class="mt-2 small text-muted font-monospace">UUID: @Model.Id</div>
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="d-flex align-items-center justify-content-center gap-3">
            <input type="hidden" asp-for="Id" />
            
            <a asp-action="Index" class="btn-action btn-cancel">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
            
            <button type="submit" class="btn-delete-confirm shadow-sm">
                <i class="bi bi-trash3 me-2"></i>Permanently Delete
            </button>
        </form>
    </div>
</div>