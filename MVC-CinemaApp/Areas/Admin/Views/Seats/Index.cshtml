@using Core.Enums
@model List<Core.DTOs.SeatDTO>

@{
    ViewData["Title"] = "Seat Layout Management";
    int hallId = ViewBag.HallId;
    string hallName = ViewBag.HallName;
}

<link rel="stylesheet" href="~/css/admin-base.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/admin-seats.css" asp-append-version="true"/>

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null) {
        <div class="alert-custom">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null) {
        <div class="alert-custom error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0 text-white">Seat Layout Management</h2>
            <p class="text-muted small m-0 mt-2">
                Configuring seats for
                <span class="hall-badge-seats">
                    <i class="bi bi-door-closed"></i>@hallName
                </span>
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn-action btn-soft-success shadow-sm" data-bs-toggle="modal"
                    data-bs-target="#addSeatModal">
                <i class="bi bi-plus-circle"></i> Add Seat
            </button>

            <a asp-action="Create" asp-route-hallId="@hallId" class="btn-action btn-soft-warning shadow-sm">
                <i class="bi bi-arrow-repeat"></i> Regenerate
            </a>

            @if (Model.Any()) {
                <form asp-action="DeleteAll" method="post" class="d-inline"
                      onsubmit="return confirm('Are you sure you want to delete ALL seats in this hall? This cannot be undone.');">
                    <input type="hidden" name="hallId" value="@hallId"/>
                    <button type="submit" class="btn-action btn-soft-danger shadow-sm">
                        <i class="bi bi-trash3"></i> Clear Hall
                    </button>
                </form>
            }

            <a asp-controller="Halls" asp-action="Index" class="btn-action btn-soft-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    @if (!Model.Any()) {
        <div class="layout-card">
            <div class="empty-state-seats">
                <i class="bi bi-grid-3x3-gap d-block"></i>
                <h4>No Seats Configured</h4>
                <p>This hall doesn't have any seats set up yet. Generate a grid layout or add seats manually to start
                    selling tickets.</p>
                <div class="d-flex gap-3 justify-content-center">
                    <a asp-action="Create" asp-route-hallId="@hallId" class="btn-action btn-soft-primary btn-action-lg">
                        <i class="bi bi-grid-3x3-gap"></i> Create Layout
                    </a>
                    <button type="button" class="btn-action btn-soft-success btn-action-lg" data-bs-toggle="modal"
                            data-bs-target="#addSeatModal">
                        <i class="bi bi-plus-circle"></i> Add Manually
                    </button>
                </div>
            </div>
        </div>
    } else {
        <div class="layout-card">
            <!-- Screen -->
            <div class="row justify-content-center mb-5">
                <div class="col-lg-12 col-md-10">
                    <div class="screen-element">SCREEN</div>
                </div>
            </div>

            <!-- Seat Grid -->
            <div class="seat-grid-layout">
                <div class="d-flex flex-column align-items-center">
                    @foreach (var rowGroup in Model.GroupBy(x => x.RowNumber).OrderBy(x => x.Key)) {
                        var maxSeatInRow = rowGroup.Max(x => x.SeatNumber);
                        <div class="d-flex mb-3 align-items-center">
                            <div class="row-label-seats">Row @rowGroup.Key</div>
                            @for (byte i = 1; i <= maxSeatInRow; i++) {
                                var seat = rowGroup.FirstOrDefault(x => x.SeatNumber == i);
                                if (seat != null) {
                                    <div class="seat-wrapper">
                                        <form asp-action="ToggleType" method="post" class="d-inline seat-toggle-form">
                                            <input type="hidden" name="id" value="@seat.Id"/>
                                            <input type="hidden" name="hallId" value="@seat.HallId"/>
                                            <button type="submit"
                                                    class="seat-btn @(seat.Type == SeatType.Premium ? "seat-premium" : "seat-regular")">
                                                @seat.SeatNumber
                                            </button>
                                        </form>
                                        <form asp-action="Delete" method="post" class="d-inline seat-delete-form">
                                            <input type="hidden" name="id" value="@seat.Id"/>
                                            <input type="hidden" name="hallId" value="@seat.HallId"/>
                                            <button type="submit" class="delete-btn">×</button>
                                        </form>
                                    </div>
                                } else {
                                    <div class="seat-spacer"></div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Legend -->
            <div class="legend-seats">
                <div class="legend-item">
                    <div class="legend-box seat-regular"></div>
                    <span>Regular Seat (Click to toggle)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-box seat-premium"></div>
                    <span>Premium Seat (Click to toggle)</span>
                </div>
                <div class="legend-item">
                    <i class="bi bi-x-circle text-danger me-1"></i>
                    <span>Hover to delete</span>
                </div>
            </div>
        </div>
    }
</div>

<!-- Add Seat Modal -->
<div class="modal fade" id="addSeatModal" tabindex="-1" aria-labelledby="addSeatModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-dark">
            <form asp-action="Add" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addSeatModalLabel">
                        <i class="bi bi-plus-circle me-2 text-success"></i>Add Single Seat
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="HallId" value="@hallId"/>

                    <div class="mb-3">
                        <label for="RowNumber" class="form-label">Row Number</label>
                        <div class="input-group">
                            <span class="input-group-text text-success">
                                <i class="bi bi-distribute-vertical"></i>
                            </span>
                            <input type="number" class="form-control" name="RowNumber" required min="1" max="50"
                                   placeholder="e.g. 1">
                        </div>
                        <small class="text-muted">Maximum: 50</small>
                    </div>

                    <div class="mb-3">
                        <label for="SeatNumber" class="form-label">Seat Number</label>
                        <div class="input-group">
                            <span class="input-group-text text-success">
                                <i class="bi bi-distribute-horizontal"></i>
                            </span>
                            <input type="number" class="form-control" name="SeatNumber" required min="1" max="50"
                                   placeholder="e.g. 5">
                        </div>
                        <small class="text-muted">Maximum: 50</small>
                    </div>

                    <div class="mb-3">
                        <label for="Type" class="form-label">Seat Type</label>
                        <select class="form-select" name="Type">
                            @foreach (var type in Enum.GetValues(typeof(SeatType))) {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-action btn-soft-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Close
                    </button>
                    <button type="submit" class="btn-action btn-soft-success">
                        <i class="bi bi-check-circle"></i> Save Seat
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/seats-ajax.js" asp-append-version="true"></script>