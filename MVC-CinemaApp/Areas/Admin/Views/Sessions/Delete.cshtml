@model Core.DTOs.SessionDTO
@{
    ViewData["Title"] = "Delete Session";
}

<link rel="stylesheet" href="~/css/admin-base.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/admin-sessions.css" asp-append-version="true"/>

<div class="container delete-container">
    <div class="delete-card">
        <div class="warning-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>

        <h3 class="fw-bold text-white mb-2">Confirm Session Deletion</h3>
        <p class="text-muted mb-4">You are about to permanently remove this screening session. This action cannot be
            undone.</p>

        <div class="session-info-box">
            <div class="info-row">
                <span class="info-label">
                    <i class="bi bi-film"></i> Movie
                </span>
                <span class="movie-badge">
                    <i class="bi bi-film"></i> @ViewBag.MovieName
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">
                    <i class="bi bi-door-closed"></i> Hall
                </span>
                <span class="hall-badge">
                    <i class="bi bi-door-closed"></i> @ViewBag.HallName
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">
                    <i class="bi bi-calendar3"></i> Date & Time
                </span>
                <span class="info-value">@Model.StartTime.ToString("MMM dd, yyyy HH:mm")</span>
            </div>
            <div class="info-row">
                <span class="info-label">
                    ₴ Base Price
                </span>
                <span class="info-value" style="color: #34d399;">@Model.BasePrice.ToString("C")</span>
            </div>
        </div>

        <div class="warning-message">
            <i class="bi bi-shield-exclamation"></i>
            <strong>Warning:</strong> Deleting this session will also cancel all associated bookings and tickets.
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="d-flex align-items-center justify-content-center gap-3">
            <input type="hidden" asp-for="Id"/>

            <a asp-action="Index" class="btn-action btn-cancel">
                <i class="bi bi-x-circle"></i> Cancel
            </a>

            <button type="submit" class="btn-delete-confirm shadow-sm">
                <i class="bi bi-trash3-fill"></i> Delete Session
            </button>
        </form>
    </div>
</div>