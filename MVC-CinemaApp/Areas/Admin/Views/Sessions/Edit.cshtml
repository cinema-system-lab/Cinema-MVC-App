@model Core.DTOs.SessionDTO
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Edit Session";
}

<link rel="stylesheet" href="~/css/admin-base.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/admin-sessions.css" asp-append-version="true"/>

<div class="container py-5">
    <div class="mb-4 d-flex justify-content-between align-items-end">
        <div>
            <h2 class="fw-bold m-0 text-white">Edit Session</h2>
            <p class="text-muted small m-0">Update screening details and schedule</p>
        </div>
        <a asp-action="Index" class="text-muted small text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Sessions
        </a>
    </div>

    <div class="edit-card">
        <form asp-action="Edit" method="post" id="sessionForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row g-4">
                <div class="col-lg-7">
                    <h5 class="section-title">
                        <i class="bi bi-calendar-event me-2 text-primary"></i>Session Details
                    </h5>

                    <div class="mb-4">
                        <label asp-for="MovieId" class="form-label">Movie</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-primary" style="border-color: var(--admin-border); border-right: none;">
                                <i class="bi bi-film"></i>
                            </span>
                            <select asp-for="MovieId" class="form-select border-start-0" id="movieSelect">
                                <option value="">-- Select Movie --</option>
                                @foreach (var item in ViewBag.Movies as SelectList)
                                {
                                    <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="MovieId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="HallId" class="form-label">Cinema Hall</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-primary" style="border-color: var(--admin-border); border-right: none;">
                                <i class="bi bi-door-closed"></i>
                            </span>
                            <select asp-for="HallId" class="form-select border-start-0" id="hallSelect">
                                <option value="">-- Select Hall --</option>
                                @foreach (var item in ViewBag.Halls as SelectList)
                                {
                                    <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="HallId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label asp-for="StartTime" class="form-label">Start Time</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent text-primary" style="border-color: var(--admin-border); border-right: none;">
                                        <i class="bi bi-clock"></i>
                                    </span>
                                    <input asp-for="StartTime" type="datetime-local" class="form-control border-start-0" id="startTimeInput" />
                                </div>
                                <span asp-validation-for="StartTime" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-4">
                                <label asp-for="EndTime" class="form-label">End Time</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent text-primary" style="border-color: var(--admin-border); border-right: none;">
                                        <i class="bi bi-clock-history"></i>
                                    </span>
                                    <input asp-for="EndTime" type="datetime-local" class="form-control border-start-0" id="endTimeInput" />
                                </div>
                                <span asp-validation-for="EndTime" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="BasePrice" class="form-label">Base Ticket Price</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-primary" style="border-color: var(--admin-border); border-right: none;">
                                ₴
                            </span>
                            <input asp-for="BasePrice" type="number" step="0.01" class="form-control border-start-0" id="priceInput" />
                        </div>
                        <span asp-validation-for="BasePrice" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Premium seats will be priced higher automatically</small>
                    </div>
                </div>

                <div class="col-lg-5">
                    <h5 class="section-title">
                        <i class="bi bi-eye me-2 text-primary"></i>Session Preview
                    </h5>

                    <div class="preview-box active" id="previewBox">
                        <i class="bi bi-calendar-check preview-icon active" id="previewIcon"></i>
                        <h5 class="text-white mb-2">Session Summary</h5>

                        <div class="preview-info" id="previewInfo">
                            <div class="info-item">
                                <span class="info-label">
                                    <i class="bi bi-film me-1"></i> Movie
                                </span>
                                <span class="info-value" id="previewMovie">
                                    @{
                                        var selectedMovie = (ViewBag.Movies as SelectList)?.SelectedValue != null 
                                            ? (ViewBag.Movies as IEnumerable<SelectListItem>)?.FirstOrDefault(m => m.Selected)?.Text 
                                            : "-";
                                    }
                                    @selectedMovie
                                </span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">
                                    <i class="bi bi-door-closed me-1"></i> Hall
                                </span>
                                <span class="info-value" id="previewHall">
                                    @{
                                        var selectedHall = (ViewBag.Halls as SelectList)?.SelectedValue != null 
                                            ? (ViewBag.Halls as IEnumerable<SelectListItem>)?.FirstOrDefault(h => h.Selected)?.Text 
                                            : "-";
                                    }
                                    @selectedHall
                                </span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">
                                    <i class="bi bi-calendar3 me-1"></i> Date
                                </span>
                                <span class="info-value" id="previewDate">@Model.StartTime.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">
                                    <i class="bi bi-clock me-1"></i> Time
                                </span>
                                <span class="info-value" id="previewTime">@Model.StartTime.ToString("HH:mm") - @Model.EndTime.ToString("HH:mm")</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">
                                    <i class="bi bi-hourglass-split me-1"></i> Duration
                                </span>
                                <span class="info-value" id="previewDuration">@((Model.EndTime - Model.StartTime).TotalMinutes) minutes</span>
                            </div>
                            <div class="info-item" style="padding-top: 12px; border-top: 1px solid var(--admin-border);">
                                <span class="info-label">
                                    ₴ Base Price
                                </span>
                                <span class="info-value" style="font-size: 1.3rem; color: #60a5fa;" id="previewPrice">
                                    ₴@Model.BasePrice.ToString("F2")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 mt-4 pt-3" style="border-top: 1px solid var(--admin-border);">
                <button type="submit" class="btn-action btn-save shadow-sm">
                    <i class="bi bi-check-lg"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn-action btn-cancel">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/session-form.js" asp-append-version="true"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}