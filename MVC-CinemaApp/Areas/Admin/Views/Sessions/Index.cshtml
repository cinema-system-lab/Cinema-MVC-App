@model IEnumerable<Core.DTOs.SessionDTO>
@{
    ViewData["Title"] = "Sessions Management";
    var currentStatus = ViewData["CurrentStatus"]?.ToString() ?? "active";
}

<link rel="stylesheet" href="~/css/admin-base.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/admin-sessions.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/pagination.css" asp-append-version="true"/>

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold m-0 text-white">Screening Sessions</h4>
            <p class="text-muted small m-0">Manage movie showtime and schedules</p>
        </div>

        <a asp-action="Create" class="btn-action btn-soft-success shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> Create New Session
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">
        <div class="search-container">
            <i class="bi bi-search"></i>
            <input type="text"
                   id="sessionSearch"
                   class="search-input"
                   data-search-target="sessionTableBody"
                   data-search-columns=".movie-title, .hall-badge"
                   placeholder="Search by movie or hall...">
        </div>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <div class="btn-group status-filter-group" role="group" aria-label="Status filter">
                <a asp-action="Index"
                   asp-route-status="active"
                   class="btn-filter @(currentStatus == "active" ? "active" : "")"
                   title="Ongoing and Upcoming sessions">
                    <i class="bi bi-play-circle-fill"></i> Active
                </a>
                <a asp-action="Index"
                   asp-route-status="ongoing"
                   class="btn-filter @(currentStatus == "ongoing" ? "active" : "")"
                   title="Currently playing">
                    <i class="bi bi-broadcast"></i> Ongoing
                </a>
                <a asp-action="Index"
                   asp-route-status="upcoming"
                   class="btn-filter @(currentStatus == "upcoming" ? "active" : "")"
                   title="Future sessions">
                    <i class="bi bi-calendar-event"></i> Upcoming
                </a>
                <a asp-action="Index"
                   asp-route-status="finished"
                   class="btn-filter @(currentStatus == "finished" ? "active" : "")"
                   title="Completed sessions">
                    <i class="bi bi-check-circle-fill"></i> Finished
                </a>
                <a asp-action="Index"
                   asp-route-status="all"
                   class="btn-filter @(currentStatus == "all" ? "active" : "")"
                   title="All sessions">
                    <i class="bi bi-collection-fill"></i> All
                </a>
            </div>

            <div class="text-muted small">
                Showing <span id="visibleCount">@Model.Count()</span> sessions
            </div>
        </div>
    </div>

    <div class="session-card">
        @if (Model == null || !Model.Any()) {
            <div class="empty-state">
                <i class="bi bi-calendar-x"></i>
                <h5 class="text-white mb-2">No Sessions Found</h5>
                <p class="text-muted mb-0">
                    @if (currentStatus == "active") {
                        <text>No active or upcoming sessions found.</text>
                    } else if (currentStatus == "ongoing") {
                        <text>No ongoing sessions at the moment.</text>
                    } else if (currentStatus == "upcoming") {
                        <text>No upcoming sessions scheduled.</text>
                    } else if (currentStatus == "finished") {
                        <text>No finished sessions found.</text>
                    } else {
                        <text>No screening sessions found in the database.</text>
                    }
                </p>
            </div>
        } else {
            <div class="table-responsive">
                <table class="table table-admin"
                       id="sessionTable"
                       data-pagination="true"
                       data-pagination-items="10"
                       data-sort-enabled="true">
                    <thead>
                    <tr>
                        <th class="ps-4 sortable" data-column="0">
                            Movie <i class="bi bi-arrow-down-up ms-1"></i>
                        </th>
                        <th class="sortable" data-column="1">
                            Hall <i class="bi bi-arrow-down-up ms-1"></i>
                        </th>
                        <th class="sortable" data-column="2">
                            Start Time <i class="bi bi-arrow-down-up ms-1"></i>
                        </th>
                        <th>Duration</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                    </thead>
                    <tbody id="sessionTableBody">
                    @foreach (var session in Model) {
                        var movieName = ViewBag.MovieNames.ContainsKey(session.MovieId)
                            ? ViewBag.MovieNames[session.MovieId] as string
                            : "Unknown Movie";
                        var hallName = ViewBag.HallNames[session.HallId] as string;
                        var duration = (session.EndTime - session.StartTime).TotalMinutes;
                        var now = DateTime.Now;
                        var isOngoing = now >= session.StartTime && now <= session.EndTime;
                        var isUpcoming = now < session.StartTime;

                        <tr class="session-row">
                            <td class="ps-4">
                                <div class="movie-title">
                                    <i class="bi bi-film text-primary"></i>
                                    @movieName
                                </div>
                            </td>
                            <td>
                                    <span class="hall-badge">
                                        <i class="bi bi-door-closed"></i> @hallName
                                    </span>
                            </td>
                            <td>
                                <div class="time-display">
                                    <div><strong>@session.StartTime.ToString("MMM dd, yyyy")</strong></div>
                                    <div>@session.StartTime.ToString("HH:mm") - @session.EndTime.ToString("HH:mm")</div>
                                </div>
                            </td>
                            <td>
                                    <span class="text-muted small">
                                        <i class="bi bi-hourglass-split me-1"></i>@duration min
                                    </span>
                            </td>
                            <td>
                                    <span class="price-display">
                                        ₴@session.BasePrice.ToString("F2")
                                    </span>
                            </td>
                            <td>
                                @if (isOngoing) {
                                    <span class="status-badge badge-ongoing">
                                            <i class="bi bi-play-fill"></i> Ongoing
                                        </span>
                                } else if (isUpcoming) {
                                    <span class="status-badge badge-upcoming">
                                            <i class="bi bi-calendar-check"></i> Upcoming
                                        </span>
                                } else {
                                    <span class="status-badge badge-finished">
                                            <i class="bi bi-check-circle"></i> Finished
                                        </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Details" asp-route-id="@session.Id" class="btn-action btn-soft-info">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@session.Id"
                                       class="btn-action btn-soft-warning">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@session.Id"
                                       class="btn-action btn-soft-danger">
                                        <i class="bi bi-trash3"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div id="noResults" class="d-none">
                    <i class="bi bi-search"></i>
                    <p>No matches found for your search.</p>
                </div>
            </div>

            @await Html.PartialAsync("_Pagination")
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/pagination.js" asp-append-version="true"></script>
    <script src="~/js/search-sort.js" asp-append-version="true"></script>
}