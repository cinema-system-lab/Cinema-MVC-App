@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark border-danger shadow-lg text-center">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock display-1 text-danger"></i>
                    </div>
                    <h2 class="fw-bold text-white mb-3 text-uppercase">Access Denied</h2>
                    <p class="text-muted fs-5 mb-4">
                        The content you're trying to reach is restricted.
                        Please sign in with an authorized account or head back to the main page.
                    </p>
                    <hr class="border-secondary mb-4" />
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                        <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-light rounded-0 px-4 fw-bold">
                            GO TO MOVIES
                        </a>
                        <form asp-controller="Account" asp-action="Logout" asp-route-returnUrl="/Account/Login" method="post" style="display: inline;">
                            <button type="submit" class="btn btn-danger rounded-0 px-4 fw-bold w-100">
                                SIGN IN AS ADMIN
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>