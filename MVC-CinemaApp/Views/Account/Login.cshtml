@model Core.DTOs.LoginDTO
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card bg-dark border-secondary shadow-lg">
                <div class="card-header border-secondary py-3 text-center">
                    <h3 class="fw-bold m-0 text-white text-uppercase">Sign In</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-muted small fw-bold text-uppercase">Email Address</label>
                            <input asp-for="Email" class="form-control admin-input" placeholder="name@example.com" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-muted small fw-bold text-uppercase">Password</label>
                            <div class="input-group">
                                <input asp-for="Password" class="form-control admin-input border-end-0" type="password" placeholder="••••••••" autocomplete="current-password" id="loginPassword" />
                                <button class="btn btn-dark border border-secondary border-start-0 text-muted" type="button" onclick="togglePassword('loginPassword', 'toggleLoginIcon')">
                                    <i class="bi bi-eye" id="toggleLoginIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
                            <label asp-for="RememberMe" class="form-check-label text-white small" for="rememberMe">Stay signed in</label>
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" class="btn btn-danger rounded-0 py-2 fw-bold text-uppercase">Login</button>
                        </div>
                    </form>

                    <div class="text-center border-top border-secondary pt-4">
                        <p class="text-muted small mb-2">New to CinemaApp?</p>
                        <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-outline-light btn-sm rounded-0 px-4 fw-bold">JOIN US</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }
    </script>
}