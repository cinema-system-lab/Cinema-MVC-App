@using Core.Enums
@model Core.DTOs.HallDTO
@{
    var upcomingSessions = ViewBag.UpcomingSessions as List<Core.DTOs.HallSessionInfoDTO> ?? new List<Core.DTOs.HallSessionInfoDTO>();
    var statistics = ViewBag.Statistics as Core.DTOs.HallStatisticsDTO;
}

<h2>Hall Details</h2>

<div class="row">
    <!-- Left Column -->
    <div class="col-md-6">
        <!-- Basic Information -->
        <div class="card mb-3">
            <div class="card-header">
                <h5>Basic Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Type</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info">@Model.Type</span>
                    </dd>

                    <dt class="col-sm-4">Total Seats</dt>
                    <dd class="col-sm-8">
                        <strong>@ViewBag.SeatsCount</strong>
                        @if (ViewBag.SeatsCount == 0)
                        {
                            <span class="text-muted">(No seats configured)</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Booked Seats</dt>
                    <dd class="col-sm-8">
                        <strong>@ViewBag.BookedSeatsCount</strong>
                        @if (ViewBag.SeatsCount > 0)
                        {
                            var bookedPercentage = Math.Round((double)ViewBag.BookedSeatsCount / ViewBag.SeatsCount * 100, 1);
                            <span class="text-muted">(@bookedPercentage% of total)</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Active Sessions</dt>
                    <dd class="col-sm-8">
                        <strong>@ViewBag.ActiveSessionsCount</strong>
                        @if (ViewBag.ActiveSessionsCount > 0)
                        {
                            <span class="badge bg-success">In use</span>
                        }
                        else
                        {
                            <span class="text-muted">(No active sessions)</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Right Column -->
    <div class="col-md-6">
        <!-- Upcoming Sessions -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Upcoming Sessions</h5>
                @if (upcomingSessions.Count > 0)
                {
                    <span class="badge bg-primary">@upcomingSessions.Count</span>
                }
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                @if (upcomingSessions.Count == 0)
                {
                    <p class="text-muted">No upcoming sessions scheduled for this hall.</p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var session in upcomingSessions)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1">@session.MovieName</h6>
                                        <small class="text-muted">
                                            <i class="bi bi-clock"></i> @session.StartTime.ToString("MMM dd, HH:mm") - @session.EndTime.ToString("HH:mm")
                                        </small>
                                        <br />
                                        <small class="text-muted">
                                            <i class="bi bi-cash"></i> @session.BasePrice.ToString("C")
                                        </small>
                                    </div>
                                    <div class="text-end">
                                        @if (session.IsOngoing)
                                        {
                                            <span class="badge bg-success">Ongoing</span>
                                        }
                                        else if (session.IsStartingSoon)
                                        {
                                            <span class="badge bg-warning">Starting Soon</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Scheduled</span>
                                        }
                                        <br />
                                        <a asp-controller="Sessions" asp-action="Details" asp-route-id="@session.SessionId" class="btn btn-sm btn-outline-primary mt-1">
                                            View
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Statistics -->
        @if (statistics != null)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Performance Statistics (Last 30 Days)</h5>
                </div>
                <div class="card-body">
                    @if (statistics.TotalSessions > 0)
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-7">Total Sessions Held</dt>
                            <dd class="col-sm-5 text-end"><strong>@statistics.TotalSessions</strong></dd>

                            <dt class="col-sm-7">Tickets Sold</dt>
                            <dd class="col-sm-5 text-end"><strong>@statistics.TotalTicketsSold</strong></dd>

                            <dt class="col-sm-7">Average Occupancy</dt>
                            <dd class="col-sm-5 text-end">
                                <strong>@statistics.AverageOccupancyRate%</strong>
                                @if (statistics.AverageOccupancyRate >= 80)
                                {
                                    <span class="badge bg-success ms-1">Excellent</span>
                                }
                                else if (statistics.AverageOccupancyRate >= 60)
                                {
                                    <span class="badge bg-info ms-1">Good</span>
                                }
                                else if (statistics.AverageOccupancyRate >= 40)
                                {
                                    <span class="badge bg-warning ms-1">Fair</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger ms-1">Low</span>
                                }
                            </dd>

                            <dt class="col-sm-7">Total Revenue</dt>
                            <dd class="col-sm-5 text-end">
                                <strong class="text-success">@statistics.TotalRevenue.ToString("C")</strong>
                            </dd>
                        </dl>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No historical data yet. Statistics will appear after sessions are completed.</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Hall</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
