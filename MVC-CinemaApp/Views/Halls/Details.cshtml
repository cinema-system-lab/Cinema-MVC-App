@model Core.DTOs.HallDTO

<h2>Hall Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.Type</dd>

        <dt class="col-sm-3">Total Seats</dt>
        <dd class="col-sm-9">
            @ViewBag.SeatsCount
            @if (ViewBag.SeatsCount == 0)
            {
                <span class="text-muted">(No seats configured)</span>
            }
        </dd>

        <dt class="col-sm-3">Active Sessions</dt>
        <dd class="col-sm-9">
            @ViewBag.ActiveSessionsCount
            @if (ViewBag.ActiveSessionsCount > 0)
            {
                <span class="badge bg-success">In use</span>
            }
            else
            {
                <span class="text-muted">(No active sessions)</span>
            }
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-controller="Seats" asp-action="Index" asp-route-hallId="@Model.Id" class="btn btn-info">Manage Seats</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
