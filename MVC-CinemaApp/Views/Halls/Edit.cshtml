@using Core.Enums
@using Microsoft.AspNetCore.Mvc.Rendering
@model Core.DTOs.HallDTO
@{
    var seats = ViewBag.Seats as List<Core.DTOs.SeatDTO> ?? new List<Core.DTOs.SeatDTO>();
}

<h2>Edit Hall</h2>

<div class="row">
    <!-- Left Column: Hall Info Form -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Hall Information</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Type" class="control-label"></label>
                        <select asp-for="Type" class="form-select" asp-items="new SelectList(Enum.GetValues(typeof(HallType)))"></select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-2">Save Hall Info</button>
                    <a asp-action="Index" class="btn btn-secondary w-100">Back to List</a>
                </form>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="card mt-3">
            <div class="card-body">
                <h6 class="text-muted mb-2">Quick Stats</h6>
                <p class="mb-1"><strong>Total Seats:</strong> @ViewBag.SeatsCount</p>
                @if (seats.Any())
                {
                    var regularCount = seats.Count(s => s.Type == SeatType.Regular);
                    var premiumCount = seats.Count(s => s.Type == SeatType.Premium);
                    <p class="mb-1"><small class="text-muted">Regular: @regularCount | Premium: @premiumCount</small></p>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Seat Layout -->
    <div class="col-md-8">
        @if (seats.Any())
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Seat Layout</h5>
                    <a asp-controller="Seats" asp-action="Index" asp-route-hallId="@Model.Id" class="btn btn-sm btn-info">
                        <i class="bi bi-pencil"></i> Edit Layout
                    </a>
                </div>
                <div class="card-body">
                    <!-- Screen -->
                    <div class="w-100 bg-dark text-white text-center py-2 mb-3" 
                         style="border-radius: 0 0 50% 50%; font-size: 0.85rem; font-weight: bold; letter-spacing: 2px;">
                        SCREEN
                    </div>
                    
                    <!-- Seat Grid -->
                    <div class="d-flex flex-column align-items-center" style="max-height: 450px; overflow-y: auto;">
                        @foreach (var rowGroup in seats.GroupBy(x => x.RowNumber).OrderBy(x => x.Key))
                        {
                            var maxSeatInRow = rowGroup.Max(x => x.SeatNumber);
                            <div class="d-flex mb-2 align-items-center">
                                <div class="me-2 text-muted fw-bold" style="width: 35px; font-size: 0.8rem;">Row @rowGroup.Key</div>
                                @for (byte i = 1; i <= maxSeatInRow; i++)
                                {
                                    var seat = rowGroup.FirstOrDefault(x => x.SeatNumber == i);
                                    if (seat != null)
                                    {
                                        <div class="mx-1 d-flex align-items-center justify-content-center text-white rounded shadow-sm" 
                                             style="width: 28px; height: 28px; font-size: 0.7rem; font-weight: 500;
                                                    @(seat.Type == SeatType.Premium ? "background-color: #ffc107; color: #212529 !important;" : "background-color: #198754;")">
                                            @seat.SeatNumber
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mx-1" style="width: 28px; height: 28px;"></div>
                                    }
                                }
                            </div>
                        }
                    </div>
                    
                    <!-- Legend -->
                    <div class="mt-3 pt-3 border-top text-center">
                        <small>
                            <span class="d-inline-flex align-items-center me-3">
                                <span class="d-inline-block bg-success rounded me-1" style="width: 18px; height: 18px;"></span> Regular
                            </span>
                            <span class="d-inline-flex align-items-center">
                                <span class="d-inline-block bg-warning rounded me-1" style="width: 18px; height: 18px;"></span> Premium
                            </span>
                        </small>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header">
                    <h5>Seat Layout</h5>
                </div>
                <div class="card-body text-center">
                    <p class="text-muted mb-3">No seats configured for this hall yet.</p>
                    <a asp-controller="Seats" asp-action="Index" asp-route-hallId="@Model.Id" class="btn btn-primary">
                        Configure Seats
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

