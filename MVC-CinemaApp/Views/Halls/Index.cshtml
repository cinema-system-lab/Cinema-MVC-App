@using Core.Constants
@model IEnumerable<Core.DTOs.HallDTO>

<h2>Halls</h2>

@if (User.IsInRole(Roles.Admin))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Hall</a>
    </p>
}

@if (Model == null || !Model.Any())
{
    <p>No halls found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var hall in Model)
            {
                <tr>
                    <td>@hall.Name</td>
                    <td>@hall.Type</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@hall.Id" class="btn btn-info btn-sm">Details</a>
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <a asp-action="Edit" asp-route-id="@hall.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@hall.Id" class="btn btn-danger btn-sm">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
