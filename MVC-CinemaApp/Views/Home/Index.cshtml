@model IEnumerable<Core.DTOs.MovieDTO>
@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">
    @* Consistent Header Style *@
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom border-secondary pb-3">
        <div class="admin-nav-tabs">
            <h1 class="nav-tab active text-uppercase">Now Showing</h1>
        </div>
        <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-light rounded-0 px-4 fw-bold">VIEW ALL</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-film display-1 opacity-25"></i>
            <p class="mt-3 fs-5">The movie schedule is currently empty.</p>
        </div>
    }
    else
    {
        @* Using the same grid layout as the Movies page *@
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var movie in Model)
            {
                <div class="col">
                    @await Html.PartialAsync("_MovieCard", movie)
                </div>
            }
        </div>
    }
</div>