@model IEnumerable<Core.DTOs.MovieDTO>
@{
    ViewData["Title"] = "Cinema - Your Premium Movie Experience";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <h1 class="hero-title">Cinema Experience</h1>
            <p class="hero-subtitle">Discover the latest blockbusters and timeless classics</p>
            <div class="hero-cta">
                <a asp-controller="Sessions" asp-action="Schedule" class="btn btn-hero">
                    <i class="bi bi-ticket-perforated-fill me-2"></i>Browse Schedule
                </a>
            </div>
        </div>
    </div>
</section>

<div class="container py-5">
    <!-- Section Header -->
    <div class="section-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="section-title">Now Showing</h2>
                <p class="section-subtitle">The hottest movies in theaters now</p>
            </div>
            <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-light px-4 fw-bold">
                View All Movies <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-film display-1 opacity-25"></i>
            <p class="mt-3 fs-5">No movies currently showing. Check back soon!</p>
        </div>
    }
    else
    {
        <div class="movie-carousel-container">
            <div class="carousel-nav prev">
                <button onclick="scrollCarousel(-1)" id="prevBtn">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>
            <div class="movie-carousel" id="movieCarousel">
                @foreach (var movie in Model)
                {
                    @await Html.PartialAsync("_MovieCardEnhanced", movie)
                }
            </div>
            <div class="carousel-nav next">
                <button onclick="scrollCarousel(1)" id="nextBtn">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const carousel = document.getElementById('movieCarousel');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const prevNav = prevBtn?.parentElement;
        const nextNav = nextBtn?.parentElement;
        
        function scrollCarousel(direction) {
            const scrollAmount = 224; // card width + gap (200 + 24)
            carousel.scrollBy({
                left: direction * scrollAmount,
                behavior: 'smooth'
            });
        }
        
        function updateButtons() {
            if (!carousel || !prevBtn || !nextBtn) return;
            
            const scrollLeft = carousel.scrollLeft;
            const scrollWidth = carousel.scrollWidth - carousel.clientWidth;
            const needsScrolling = scrollWidth > 1;
            
            // Hide arrows if no scrolling needed
            if (!needsScrolling) {
                prevNav?.classList.add('hidden');
                nextNav?.classList.add('hidden');
                carousel.classList.add('centered');
            } else {
                prevNav?.classList.remove('hidden');
                nextNav?.classList.remove('hidden');
                carousel.classList.remove('centered');
                
                prevBtn.disabled = scrollLeft <= 0;
                nextBtn.disabled = scrollLeft >= scrollWidth - 1;
            }
        }
        
        if (carousel) {
            carousel.addEventListener('scroll', updateButtons);
            window.addEventListener('resize', updateButtons);
            updateButtons();
        }
        
        // Auto-scroll on arrow keys
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') scrollCarousel(-1);
            if (e.key === 'ArrowRight') scrollCarousel(1);
        });
    </script>
}