@using Microsoft.AspNetCore.Mvc.Rendering
@using Core.Enums
@model Core.DTOs.MovieDTO

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Create Movie</h2>
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#tmdbModal">
        <i class="bi bi-cloud-download"></i> 🔍 Import from TMDB
    </button>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" required maxlength="100" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Director" class="control-label"></label>
                <input asp-for="Director" class="form-control" required maxlength="100" />
                <span asp-validation-for="Director" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ReleaseDate" class="control-label"></label>
                <input asp-for="ReleaseDate" type="date" class="form-control" required
                       min="1895-01-01" max="@DateTime.Today.AddYears(5).ToString("yyyy-MM-dd")" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DurationMinutes" class="control-label">Duration (Min)</label>
                <input asp-for="DurationMinutes" class="form-control" type="number" min="1" max="600" required />
                <span asp-validation-for="DurationMinutes" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Rating" class="control-label"></label>
                <input asp-for="Rating" class="form-control" type="number" step="0.1" min="0" max="10" id="ratingInput" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group mb-3">
                <label class="form-label">Жанри</label>
                <select name="selectedGenres" id="genresSelect" class="form-select" multiple="multiple" required>
                    @foreach (GenreType genre in Enum.GetValues(typeof(GenreType)))
                    {
                        if (genre == GenreType.None) continue;

                        var isSelected = Model?.Genres.HasFlag(genre) ?? false;

                        <option value="@((int)genre)" selected="@(isSelected ? "selected" : null)">
                            @genre.ToString()
                        </option>
                    }
                </select>
                <span class="text-danger" data-valmsg-for="selectedGenres" data-valmsg-replace="true"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AgeRestriction" class="control-label"></label>
                <input asp-for="AgeRestriction" type="number" class="form-control" min="0" max="18" required />
                <span asp-validation-for="AgeRestriction" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PosterUrl" class="control-label"></label>
                <input asp-for="PosterUrl" class="form-control" placeholder="https://..." required maxlength="300" />
                <span asp-validation-for="PosterUrl" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TrailerUrl" class="control-label"></label>
                <input asp-for="TrailerUrl" class="form-control" placeholder="https://..." maxlength="300" />
                <span asp-validation-for="TrailerUrl" class="text-danger"></span>
            </div>

            <div class="form-group form-check mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>
        </div>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description" class="control-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" maxlength="1000"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Actors" class="control-label"></label>
        <input asp-for="Actors" class="form-control" placeholder="John Doe, Jane Smith" required maxlength="1000" />
        <span asp-validation-for="Actors" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create Movie</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

<div class="modal fade" id="tmdbModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Search in TMDB</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" id="tmdbSearchInput" class="form-control" placeholder="Enter movie name (e.g. Matrix)...">
                    <button class="btn btn-primary" type="button" id="btnSearchTmdb">Search</button>
                </div>
                <div id="tmdbResultsList" class="list-group"></div>
                <div id="tmdbLoading" class="text-center d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            // Ваша ініціалізація Select2
            $('#genresSelect').select2({
                placeholder: "Оберіть хоча б один жанр",
                width: '100%'
            });
            $('#genresSelect').on('change', function() { $(this).valid(); });

            // Ваша логіка для Rating
            let ratingInput = $('#ratingInput');
            // ... (ваш код рейтингу без змін) ...

            // --- ЛОГІКА TMDB MODAL ---

            // Клік на кнопку пошуку в модалці
            $('#btnSearchTmdb').click(function() {
                performTmdbSearch();
            });

            // Пошук по Enter
            $('#tmdbSearchInput').keypress(function(e) {
                if(e.which == 13) {
                    performTmdbSearch();
                }
            });

            function performTmdbSearch() {
                var query = $('#tmdbSearchInput').val();
                if (!query) return;

                $('#tmdbResultsList').empty();
                $('#tmdbLoading').removeClass('d-none');

                $.ajax({
                    url: '/Movies/SearchTmdbJson',
                    data: { query: query },
                    success: function(data) {
                        $('#tmdbLoading').addClass('d-none');
                        if (data.length === 0) {
                            $('#tmdbResultsList').html('<div class="alert alert-warning">Nothing found.</div>');
                            return;
                        }

                        // Генеруємо список результатів
                        data.forEach(function(movie) {
                            var img = movie.poster ? `<img src="${movie.poster}" style="width:50px; height:75px; object-fit:cover; margin-right:10px;">` : '';

                            var item = `
                                <a href="/Movies/CreateFromTmdb?tmdbId=${movie.id}" class="list-group-item list-group-item-action d-flex align-items-center">
                                    ${img}
                                    <div>
                                        <h6 class="mb-1">${movie.title} (${movie.year})</h6>
                                        <small class="text-muted">${movie.overview ? movie.overview.substring(0, 100) + '...' : ''}</small>
                                    </div>
                                    <button class="btn btn-sm btn-success ms-auto">Select</button>
                                </a>
                            `;
                            $('#tmdbResultsList').append(item);
                        });
                    },
                    error: function() {
                        $('#tmdbLoading').addClass('d-none');
                        $('#tmdbResultsList').html('<div class="alert alert-danger">Error searching TMDB.</div>');
                    }
                });
            }
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}