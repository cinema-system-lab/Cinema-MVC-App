@using Core.Enums
@model Core.DTOs.MovieDTO

@{
    ViewData["Title"] = "Movie Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.PosterUrl))
            {
                <img src="@Model.PosterUrl" class="img-fluid rounded shadow" alt="@Model.Title Poster" />
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px; border: 2px dashed #dee2e6;">
                    <span class="text-muted">No Poster Available</span>
                </div>
            }
        </div>

        <div class="col-md-8">
            <h2>@Model.Title</h2>
            <hr />
            
            <dl class="row">
                <dt class="col-sm-3">Director</dt>
                <dd class="col-sm-9">@Model.Director</dd>

                <dt class="col-sm-3">Release Date</dt>
                <dd class="col-sm-9">@Model.ReleaseDate.ToString("MMMM dd, yyyy")</dd>

                <dt class="col-sm-3">Duration</dt>
                <dd class="col-sm-9">@Model.DurationMinutes min</dd>

                <dt class="col-sm-3">Rating</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-warning text-dark">⭐ @Model.Rating.ToString("F1") / 10</span>
                </dd>

                <dt class="col-sm-3">Genres</dt>
                <dd class="col-sm-9">
                    @* This splits the Flags Enum into comma-separated strings *@
                    @string.Join(", ", Enum.GetValues<GenreType>()
                        .Where(g => g != GenreType.None && Model.Genres.HasFlag(g)))
                </dd>

                <dt class="col-sm-3">Age Restriction</dt>
                <dd class="col-sm-9">@Model.AgeRestriction+</dd>

                <dt class="col-sm-3">Actors</dt>
                <dd class="col-sm-9">@Model.Actors</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Movie</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                
                @if (!string.IsNullOrEmpty(Model.TrailerUrl))
                {
                    <a href="@Model.TrailerUrl" target="_blank" class="btn btn-danger">Watch Trailer</a>
                }
            </div>
        </div>
    </div>
</div>