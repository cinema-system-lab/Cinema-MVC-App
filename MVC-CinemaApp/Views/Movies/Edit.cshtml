@using Core.Enums
@model Core.DTOs.MovieDTO

@{
    var isEdit = Model?.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Movie" : "Create Movie";
}

<div class="container py-5">
    <div class="card bg-dark border-secondary shadow-lg">
        <div class="card-header border-secondary py-3 text-uppercase">
            <h2 class="h4 fw-bold m-0 text-white">
                <i class="bi bi-film text-danger me-2"></i> @ViewData["Title"]
            </h2>
        </div>
        <div class="card-body p-4">
            <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                @* Global errors *@
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-4">
                    <div class="col-md-6">
                        @* Title *@
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label text-muted small fw-bold text-uppercase">Movie Title</label>
                            <input asp-for="Title" class="form-control admin-input" placeholder="e.g. Inception" required maxlength="100" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        @* Director *@
                        <div class="mb-3">
                            <label asp-for="Director" class="form-label text-muted small fw-bold text-uppercase">Director</label>
                            <input asp-for="Director" class="form-control admin-input" placeholder="Christopher Nolan" required maxlength="100" />
                            <span asp-validation-for="Director" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            @* Release Date *@
                            <div class="col-6 mb-3">
                                <label asp-for="ReleaseDate" class="form-label text-muted small fw-bold text-uppercase">Release Date</label>
                                <input asp-for="ReleaseDate" type="date" class="form-control admin-input"
                                       required min="1895-01-01" max="@DateTime.Today.AddYears(5).ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="ReleaseDate" class="text-danger small"></span>
                            </div>
                            @* Duration *@
                            <div class="col-6 mb-3">
                                <label asp-for="DurationMinutes" class="form-label text-muted small fw-bold text-uppercase">Duration (Min)</label>
                                <input asp-for="DurationMinutes" class="form-control admin-input" type="number" min="1" max="600" required />
                                <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                            </div>
                        </div>

                        @* Rating *@
                        <div class="mb-3">
                            <label asp-for="Rating" class="form-label text-muted small fw-bold text-uppercase">IMDB Rating</label>
                            <input asp-for="Rating" class="form-control admin-input" type="number" step="0.1" min="0" max="10" id="ratingInput" />
                            <span asp-validation-for="Rating" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        @* Genres (Select2) *@
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold text-uppercase">Genres</label>
                            <select name="selectedGenres" id="genresSelect" class="form-select" multiple="multiple" required>
                                @foreach (GenreType genre in Enum.GetValues(typeof(GenreType)))
                                {
                                    if (genre == GenreType.None) continue;
                                    var isSelected = Model?.Genres.HasFlag(genre) ?? false;
                                    <option value="@((int)genre)" selected="@(isSelected ? "selected" : null)">@genre.ToString()</option>
                                }
                            </select>
                            <span class="text-danger small" data-valmsg-for="selectedGenres" data-valmsg-replace="true"></span>
                        </div>

                        @* Poster URL *@
                        <div class="mb-3">
                            <label asp-for="PosterUrl" class="form-label text-muted small fw-bold text-uppercase">Poster URL</label>
                            <input asp-for="PosterUrl" class="form-control admin-input" placeholder="https://..." required maxlength="300" />
                            <span asp-validation-for="PosterUrl" class="text-danger small"></span>
                        </div>

                        @* Trailer URL *@
                        <div class="mb-3">
                            <label asp-for="TrailerUrl" class="form-label text-muted small fw-bold text-uppercase">Trailer URL (Youtube)</label>
                            <input asp-for="TrailerUrl" class="form-control admin-input" placeholder="https://youtube.com/..." maxlength="300" />
                            <span asp-validation-for="TrailerUrl" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            @* Age Restriction *@
                            <div class="col-6 mb-3">
                                <label asp-for="AgeRestriction" class="form-label text-muted small fw-bold text-uppercase">Age Limit</label>
                                <input asp-for="AgeRestriction" class="form-control admin-input" type="number" min="0" max="18" required />
                                <span asp-validation-for="AgeRestriction" class="text-danger small"></span>
                            </div>
                            @* Is Active *@
                            <div class="col-6 d-flex align-items-end mb-3">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeSwitch">
                                    <label class="form-check-label text-white" for="activeSwitch">Visible on site</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Description *@
                <div class="mb-3 mt-2">
                    <label asp-for="Description" class="form-label text-muted small fw-bold text-uppercase">Synopsis</label>
                    <textarea asp-for="Description" class="form-control admin-input" rows="3" maxlength="1000"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                @* Actors *@
                <div class="mb-4">
                    <label asp-for="Actors" class="form-label text-muted small fw-bold text-uppercase">Cast (Comma separated)</label>
                    <input asp-for="Actors" class="form-control admin-input" placeholder="Actor 1, Actor 2..." required maxlength="1000" />
                    <span asp-validation-for="Actors" class="text-danger small"></span>
                </div>

                @* Buttons *@
                <div class="d-flex gap-2 justify-content-end border-top border-secondary pt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-5 fw-bold text-uppercase">
                        @(isEdit ? "Save Changes" : "Create Movie")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            // Select2 Init
            $('#genresSelect').select2({
                placeholder: "Select at least one genre",
                width: '100%'
            });

            // Trigger validation on Select2 change
            $('#genresSelect').on('change', function() {
                $(this).valid();
            });

            // Rating Formatter
            let rInput = $('#ratingInput');
            function formatRating() {
                let v = parseFloat(rInput.val());
                if (!isNaN(v)) rInput.val(v.toFixed(1));
            }
            rInput.on('blur change', formatRating);
            formatRating();
        });
    </script>
    @* ASP.NET Core Client-side Validation *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}