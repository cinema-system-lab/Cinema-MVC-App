@using Core.Constants
@model IEnumerable<Core.DTOs.MovieDTO>

@{
    ViewData["Title"] = "Movies";
    var today = DateTime.Today;

    var nowShowing = Model.Where(m => m.IsActive && m.ReleaseDate <= today).OrderByDescending(m => m.ReleaseDate);
    var comingSoon = Model.Where(m => m.IsActive && m.ReleaseDate > today).OrderBy(m => m.ReleaseDate);
    var archived = Model.Where(m => !m.IsActive).OrderByDescending(m => m.ReleaseDate);
}

<div class="container py-5">
    @* Navigation Tabs - ARCHIVE NOW VISIBLE TO ALL *@
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-5 border-bottom border-secondary pb-3 gap-3">
        <div class="d-flex gap-4 admin-nav-tabs">
            <h1 class="nav-tab active" onclick="showSection('now', this)">Now Showing</h1>
            <h1 class="nav-tab" onclick="showSection('soon', this)">Coming Soon</h1>
            <h1 class="nav-tab" onclick="showSection('archive', this)">Archive</h1>
        </div>

        @if (User.IsInRole(Roles.Admin))
        {
            <a asp-action="Create" class="btn btn-danger rounded-0 px-4 fw-bold shadow">ADD MOVIE</a>
        }
    </div>

    @* Section: Now Showing *@
    <div id="section-now" class="movie-section animate-fade">
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var movie in nowShowing)
            {
                <div class="col">@await Html.PartialAsync("_MovieCard", movie)</div>
            }
        </div>
    </div>

    @* Section: Coming Soon *@
    <div id="section-soon" class="movie-section d-none animate-fade">
        @foreach (var group in comingSoon.GroupBy(m => m.ReleaseDate.Date))
        {
            <div class="timeline-section">
                <div class="timeline-date">
                    <span class="day text-white">@group.Key.Day</span>
                    <span class="month text-danger text-uppercase fw-bold">@group.Key.ToString("MMM")</span>
                </div>
                <div class="timeline-content">
                    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
                        @foreach (var movie in group)
                        {
                            <div class="col">@await Html.PartialAsync("_MovieCard", movie)</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @* Section: Archive - VISIBLE TO EVERYONE *@
    <div id="section-archive" class="movie-section d-none animate-fade">
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var movie in archived)
            {
                <div class="col grayscale-filter">
                    @await Html.PartialAsync("_MovieCard", movie)
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showSection(sectionId, element) {
            document.querySelectorAll('.movie-section').forEach(s => s.classList.add('d-none'));
            document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
            document.getElementById('section-' + sectionId).classList.remove('d-none');
            element.classList.add('active');
        }
    </script>
}