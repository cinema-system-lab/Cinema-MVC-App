@model Core.DTOs.OrderDTO

@{
    ViewData["Title"] = "Order Details";
}

<div class="container py-4">
    <div class="card bg-dark border-secondary shadow-sm mb-4">
        <div class="card-body">
            <h2 class="mb-4 text-white">Order Details</h2>

            <p class="mb-1 text-white"><strong>Movie:</strong> @Model.MovieTitle</p>
            <p class="mb-1 text-white-50"><strong>Hall:</strong> @Model.HallName</p>
            <p class="mb-1 text-white-50">
                <strong>Session:</strong> @Model.SessionStartTime.ToLocalTime()
            </p>
            <p class="mb-1">
                <strong>Status:</strong>
                <span class="badge bg-secondary">@Model.Status</span>
            </p>
            <p class="mb-0 text-success fw-bold fs-5">
                Total price: @Model.TotalPrice ₴
            </p>
        </div>
    </div>

    <div class="card bg-dark border-secondary shadow-sm">
        <div class="card-body">
            <h4 class="mb-3 text-white">Tickets</h4>

            @if (!Model.Tickets.Any())
            {
                <p class="text-muted">No tickets yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Row</th>
                                <th scope="col">Seat</th>
                                <th scope="col">Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Tickets)
                            {
                                <tr>
                                    <td class="text-white-50">@t.RowNumber</td>
                                    <td class="text-white-50">@t.SeatNumber</td>
                                    <td class="text-white">@t.Price ₴</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <a asp-action="Index" class="btn btn-outline-secondary mt-3">
                Back
            </a>
        </div>
    </div>
</div>

