@using Core.Enums
@model List<Core.DTOs.OrderDTO>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <div class="card bg-dark border-secondary shadow-sm">
        <div class="card-body">
            <h2 class="mb-4 text-white">
                <i class="bi bi-ticket-perforated-fill text-danger me-2"></i>My Orders
            </h2>

            @if (TempData["SuccessMessage"] is string successMsg)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@successMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] is string errorMsg)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                    <p class="text-muted mt-3">You have no orders yet.</p>
                    <a asp-controller="Sessions" asp-action="Schedule" class="btn btn-danger mt-2">
                        <i class="bi bi-film me-1"></i> Browse Movies
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Movie</th>
                                <th scope="col">Hall</th>
                                <th scope="col">Session</th>
                                <th scope="col">Tickets</th>
                                <th scope="col">Status</th>
                                <th scope="col">Total price</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                var statusClass = order.Status switch
                                {
                                    OrderStatus.Paid => "bg-success",
                                    OrderStatus.Pending => "bg-warning text-dark",
                                    OrderStatus.Cancelled => "bg-danger",
                                    OrderStatus.Refunded => "bg-info",
                                    _ => "bg-secondary"
                                };
                                
                                <tr>
                                    <td class="text-white">@order.MovieTitle</td>
                                    <td class="text-white-50">@order.HallName</td>
                                    <td class="text-white-50">@order.SessionStartTime.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                    <td class="text-white-50">@order.Tickets.Count</td>
                                    <td>
                                        <span class="badge @statusClass">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td class="text-white fw-bold">@order.TotalPrice ₴</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-light me-1">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        @if (order.Status == OrderStatus.Pending)
                                        {
                                            <a asp-controller="Payments"
                                               asp-action="Checkout"
                                               asp-route-orderId="@order.Id"
                                               class="btn btn-sm btn-success me-1">
                                                <i class="bi bi-credit-card"></i> Pay
                                            </a>

                                            <form asp-action="Cancel"
                                                  asp-route-id="@order.Id"
                                                  method="post"
                                                  class="d-inline">
                                                <button class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Cancel this order?')">
                                                    <i class="bi bi-x-circle"></i> Cancel
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

