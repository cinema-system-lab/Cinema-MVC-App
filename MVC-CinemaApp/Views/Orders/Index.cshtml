@model List<Core.DTOs.OrderDTO>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <div class="card bg-dark border-secondary shadow-sm">
        <div class="card-body">
            <h2 class="mb-4 text-white">My Orders</h2>

            @if (!Model.Any())
            {
                <p class="text-muted">You have no orders yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Movie</th>
                                <th scope="col">Hall</th>
                                <th scope="col">Session</th>
                                <th scope="col">Status</th>
                                <th scope="col">Total price</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="text-white">@order.MovieTitle</td>
                                    <td class="text-white-50">@order.HallName</td>
                                    <td class="text-white-50">@order.SessionStartTime.ToLocalTime()</td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td class="text-white">@order.TotalPrice ₴</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-light me-1">
                                            Details
                                        </a>

                                        @if (order.Status == Core.Enums.OrderStatus.Pending)
                                        {
                                            <form asp-action="Cancel"
                                                  asp-route-id="@order.Id"
                                                  method="post"
                                                  class="d-inline">
                                                <button class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Cancel this order?')">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

