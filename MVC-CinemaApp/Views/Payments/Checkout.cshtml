@using Core.Enums
@model Core.DTOs.OrderDTO

@{
    ViewData["Title"] = "Checkout";
    var paymentExpiresAtUtc = ViewBag.PaymentExpiresAtUtc as DateTime?;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card bg-dark border-secondary shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <h2 class="text-white mb-0">
                            <i class="bi bi-credit-card me-2"></i>Complete Your Payment
                        </h2>
                        
                        @if (paymentExpiresAtUtc.HasValue)
                        {
                            <div class="hold-timer text-end" aria-live="polite">
                                <div class="small text-muted">Payment time</div>
                                <div class="fs-4 fw-bold text-warning" id="checkout-timer">--:--</div>
                            </div>
                        }
                    </div>

                    @if (TempData["ErrorMessage"] is string errorMsg)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMsg
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="mb-4">
                        <h5 class="text-muted text-uppercase small mb-3">Order Summary</h5>

                        <div class="bg-black rounded p-3 mb-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <p class="mb-1 text-white"><strong>Movie:</strong> @Model.MovieTitle</p>
                                    <p class="mb-1 text-white-50"><strong>Hall:</strong> @Model.HallName</p>
                                    <p class="mb-1 text-white-50">
                                        <strong>Session:</strong> @Model.SessionStartTime.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                    </p>
                                </div>
                                <div class="col-md-6 text-md-end">
                                    <p class="mb-1 text-white-50">
                                        <strong>Tickets:</strong> @Model.Tickets.Count
                                    </p>
                                    <p class="mb-0 text-success fw-bold fs-4">
                                        Total: @Model.TotalPrice ₴
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Tickets.Any())
                    {
                        <div class="mb-4">
                            <h6 class="text-muted text-uppercase small mb-2">Selected Seats</h6>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var t in Model.Tickets)
                                {
                                    var badgeClass = t.SeatType == SeatType.Premium ? "bg-warning text-dark" : "bg-secondary";
                                    <span class="badge @badgeClass">
                                        Row @t.RowNumber, Seat @t.SeatNumber
                                        (@(t.SeatType == SeatType.Premium ? "Premium" : "Standard") - @t.Price ₴)
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    <hr class="border-secondary" />

                    <form asp-controller="Payments" asp-action="Pay" method="post" id="paymentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Back to orders
                            </a>

                            <button type="submit" class="btn btn-success btn-lg px-5 fw-bold" id="payButton">
                                <i class="bi bi-credit-card me-2"></i>Pay @Model.TotalPrice ₴
                            </button>
                        </div>
                    </form>
                    
                    <!-- Hidden form for expiration cancellation -->
                    <form asp-controller="Payments" asp-action="CancelExpired" method="post" id="cancelExpiredForm" class="d-none">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Timer expired modal -->
<div class="modal fade" id="expiredModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-danger">
            <div class="modal-body text-center py-5">
                <i class="bi bi-clock-history text-danger display-1 mb-3"></i>
                <h4 class="text-white mb-3">Time Expired!</h4>
                <p class="text-muted mb-4">
                    Your seat reservation has expired. You will be redirected to select your seats again.
                </p>
                <button type="button" class="btn btn-danger px-4" id="redirectBtn">
                    <i class="bi bi-arrow-repeat me-2"></i>Select Seats Again
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            const paymentExpiresAtUtcStr = '@(paymentExpiresAtUtc?.ToString("o") ?? "")';
            if (!paymentExpiresAtUtcStr) return;
            
            const expiresAt = new Date(paymentExpiresAtUtcStr);
            const timerEl = document.getElementById('checkout-timer');
            const payButton = document.getElementById('payButton');
            const cancelForm = document.getElementById('cancelExpiredForm');
            const expiredModal = new bootstrap.Modal(document.getElementById('expiredModal'));
            const redirectBtn = document.getElementById('redirectBtn');
            
            function updateTimer() {
                const now = new Date();
                const diff = expiresAt - now;
                
                if (diff <= 0) {
                    timerEl.textContent = '00:00';
                    timerEl.classList.remove('text-warning');
                    timerEl.classList.add('text-danger');
                    payButton.disabled = true;
                    payButton.classList.remove('btn-success');
                    payButton.classList.add('btn-secondary');
                    
                    // Show modal
                    expiredModal.show();
                    return;
                }
                
                const minutes = Math.floor(diff / 60000);
                const seconds = Math.floor((diff % 60000) / 1000);
                timerEl.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
                
                // Warning colors
                if (diff <= 60000) { // Last minute
                    timerEl.classList.remove('text-warning');
                    timerEl.classList.add('text-danger');
                } else if (diff <= 180000) { // Last 3 minutes
                    timerEl.classList.remove('text-warning');
                    timerEl.classList.add('text-orange');
                }
                
                setTimeout(updateTimer, 1000);
            }
            
            // Handle redirect button
            redirectBtn.addEventListener('click', function() {
                cancelForm.submit();
            });
            
            // Start timer
            updateTimer();
        })();
    </script>
}