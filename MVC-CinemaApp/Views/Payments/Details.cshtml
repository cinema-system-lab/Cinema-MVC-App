@model Core.DTOs.PaymentDTO

@{
    ViewData["Title"] = "Payment Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-receipt"></i> Payment Details
        </h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Payment Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Payment ID:</dt>
                        <dd class="col-sm-8">
                            <code>@Model.Id</code>
                        </dd>

                        <dt class="col-sm-4">Order ID:</dt>
                        <dd class="col-sm-8">
                            <code>@Model.OrderId</code>
                        </dd>

                        <dt class="col-sm-4">Amount:</dt>
                        <dd class="col-sm-8">
                            <h4 class="text-success mb-0">
                                <i class="bi bi-currency-dollar"></i>@Model.Amount.ToString("F2")
                            </h4>
                        </dd>

                        <dt class="col-sm-4">Payment Date:</dt>
                        <dd class="col-sm-8">
                            <i class="bi bi-calendar-event"></i> 
                            @Model.PaymentDate.ToString("dddd, dd MMMM yyyy")
                            <br>
                            <i class="bi bi-clock"></i> 
                            @Model.PaymentDate.ToString("HH:mm:ss")
                        </dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @switch (Model.Status)
                            {
                                case Core.Enums.PaymentStatus.Pending:
                                    <span class="badge bg-warning text-dark fs-6">
                                        <i class="bi bi-clock"></i> Pending
                                    </span>
                                    break;
                                case Core.Enums.PaymentStatus.Success:
                                    <span class="badge bg-success fs-6">
                                        <i class="bi bi-check-circle"></i> Success
                                    </span>
                                    break;
                                case Core.Enums.PaymentStatus.Failed:
                                    <span class="badge bg-danger fs-6">
                                        <i class="bi bi-x-circle"></i> Failed
                                    </span>
                                    break;
                                case Core.Enums.PaymentStatus.Refunded:
                                    <span class="badge bg-info fs-6">
                                        <i class="bi bi-arrow-counterclockwise"></i> Refunded
                                    </span>
                                    break;
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">Update Status</h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">New Status:</label>
                            <select name="newStatus" class="form-select" required>
                                <option value="">-- Select Status --</option>
                                @{
                                    var pendingValue = (int)Core.Enums.PaymentStatus.Pending;
                                    var successValue = (int)Core.Enums.PaymentStatus.Success;
                                    var failedValue = (int)Core.Enums.PaymentStatus.Failed;
                                    var refundedValue = (int)Core.Enums.PaymentStatus.Refunded;
                                }
                                <option value="@pendingValue" selected="@(Model.Status == Core.Enums.PaymentStatus.Pending)">
                                    Pending
                                </option>
                                <option value="@successValue" selected="@(Model.Status == Core.Enums.PaymentStatus.Success)">
                                    Success
                                </option>
                                <option value="@failedValue" selected="@(Model.Status == Core.Enums.PaymentStatus.Failed)">
                                    Failed
                                </option>
                                <option value="@refundedValue" selected="@(Model.Status == Core.Enums.PaymentStatus.Refunded)">
                                    Refunded
                                </option>
                            </select>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-arrow-repeat"></i> Update Status
                            </button>
                        </div>
                    </form>

                    <hr>

                    <div class="alert alert-info mb-0">
                        <small>
                            <i class="bi bi-info-circle"></i> 
                            <strong>Note:</strong> Changing payment status will also update the related order status.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>