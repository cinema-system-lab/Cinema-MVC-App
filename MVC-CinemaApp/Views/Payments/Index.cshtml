@model IEnumerable<Core.DTOs.PaymentDTO>

@{
    ViewData["Title"] = "Payments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-credit-card"></i> Payments Management
        </h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Payment ID</th>
                                <th>Order ID</th>
                                <th>Amount</th>
                                <th>Payment Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model)
                            {
                                <tr>
                                    <td>
                                        <small class="text-muted font-monospace">
                                            @payment.Id.ToString().Substring(0, 8)...
                                        </small>
                                    </td>
                                    <td>
                                        <small class="text-muted font-monospace">
                                            @payment.OrderId.ToString().Substring(0, 8)...
                                        </small>
                                    </td>
                                    <td>
                                        <strong class="text-success">$@payment.Amount.ToString("F2")</strong>
                                    </td>
                                    <td>
                                        <small>@payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        @switch (payment.Status)
                                        {
                                            case Core.Enums.PaymentStatus.Pending:
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-clock"></i> Pending
                                                </span>
                                                break;
                                            case Core.Enums.PaymentStatus.Success:
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> Success
                                                </span>
                                                break;
                                            case Core.Enums.PaymentStatus.Failed:
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle"></i> Failed
                                                </span>
                                                break;
                                            case Core.Enums.PaymentStatus.Refunded:
                                                <span class="badge bg-info">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Refunded
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@payment.Id" 
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <p class="text-muted">
                        <i class="bi bi-info-circle"></i> Total Payments: <strong>@Model.Count()</strong>
                    </p>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="lead text-muted mt-3">No payments found</p>
                </div>
            }
        </div>
    </div>
</div>