@using Core.Enums
@model Core.DTOs.OrderDTO

@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-success rounded-circle mb-3" 
                     style="width: 80px; height: 80px;">
                    <i class="bi bi-check-lg text-white fs-1"></i>
                </div>
                <h1 class="text-white fw-bold">Payment Successful!</h1>
                <p class="text-muted">Your tickets have been confirmed. Enjoy the movie!</p>
            </div>

            <div class="card bg-dark border-secondary shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="text-muted text-uppercase small mb-3">Your Tickets</h5>
                    
                    <div class="bg-black rounded p-4 mb-3">
                        <h3 class="text-white mb-3">@Model.MovieTitle</h3>
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-2 text-white-50">
                                    <i class="bi bi-calendar-event me-2"></i>
                                    @Model.SessionStartTime.ToLocalTime().ToString("dddd, dd MMMM yyyy")
                                </p>
                                <p class="mb-2 text-white-50">
                                    <i class="bi bi-clock me-2"></i>
                                    @Model.SessionStartTime.ToLocalTime().ToString("HH:mm")
                                </p>
                                <p class="mb-0 text-white-50">
                                    <i class="bi bi-geo-alt-fill me-2"></i>
                                    @Model.HallName
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-2 text-white-50">
                                    <i class="bi bi-ticket-perforated-fill me-2"></i>
                                    @Model.Tickets.Count ticket(s)
                                </p>
                                <p class="mb-0 text-success fw-bold fs-5">
                                    <i class="bi bi-cash me-2"></i>
                                    Total: @Model.TotalPrice ₴
                                </p>
                            </div>
                        </div>
                    </div>

                    <h6 class="text-muted text-uppercase small mb-2">Seat Details</h6>
                    <div class="table-responsive">
                        <table class="table table-dark table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Row</th>
                                    <th>Seat</th>
                                    <th>Type</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model.Tickets)
                                {
                                    <tr>
                                        <td class="text-white">@ticket.RowNumber</td>
                                        <td class="text-white">@ticket.SeatNumber</td>
                                        <td>
                                            @if (ticket.SeatType == SeatType.Premium)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-star-fill me-1"></i>Premium
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Standard</span>
                                            }
                                        </td>
                                        <td class="text-white">@ticket.Price ₴</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-list-ul me-1"></i> View My Orders
                </a>
                <a asp-controller="Sessions" asp-action="Schedule" class="btn btn-danger px-4">
                    <i class="bi bi-film me-1"></i> Book Another Movie
                </a>
            </div>
        </div>
    </div>
</div>
