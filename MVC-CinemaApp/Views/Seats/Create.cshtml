@model Core.DTOs.SeatGenerationDTO

<h2>Generate Seats Layout</h2>
<h4>For Hall: @ViewBag.HallName</h4>
<hr />

<div class="alert alert-warning">
    <strong>Warning!</strong> Generating seats will delete all existing seats in this hall.
</div>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <input type="hidden" asp-for="HallId" />
            
            <div class="form-group mb-3">
                <label asp-for="Rows" class="control-label">Number of Rows</label>
                <input asp-for="Rows" class="form-control" type="number" min="1" max="50" />
                <span asp-validation-for="Rows" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SeatsPerRow" class="control-label">Seats per Row</label>
                <input asp-for="SeatsPerRow" class="form-control" type="number" min="1" max="50" />
                <span asp-validation-for="SeatsPerRow" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-danger">Generate Seats</button>
                <a asp-controller="Halls" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>