@model List<Core.DTOs.SeatDTO>

@{
    int hallId = ViewBag.HallId;
    string hallName = ViewBag.HallName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Seat Layout: @hallName</h2>
    <div>
        @* Кнопка для перегенерації *@
        <a asp-action="Create" asp-route-hallId="@hallId" class="btn btn-warning">Regenerate Layout</a>
        <a asp-controller="Halls" asp-action="Index" class="btn btn-outline-secondary">Back to Halls</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center mt-5">
        <h4>No seats configured yet.</h4>
        <a asp-action="Create" asp-route-hallId="@hallId" class="btn btn-primary mt-3">Create Layout</a>
    </div>
}
else
{
    <div class="mb-4">
        <div class="w-100 bg-secondary text-white text-center py-2 shadow-sm" style="border-radius: 0 0 50% 50%; letter-spacing: 5px;">
            SCREEN
        </div>
    </div>

    <div class="d-flex flex-column align-items-center">
        @* Групуємо місця по рядах *@
        @foreach (var rowGroup in Model.GroupBy(x => x.RowNumber).OrderBy(x => x.Key))
        {
            <div class="d-flex mb-2 align-items-center">
                <div class="me-3 fw-bold text-muted">Row @rowGroup.Key</div>
                
                @foreach (var seat in rowGroup.OrderBy(x => x.SeatNumber))
                {
                    <div class="seat-container mx-1 text-center" style="position: relative;">
                        <div class="card p-1 text-white @(seat.Type == Core.Enums.SeatType.Premium ? "bg-warning" : "bg-success")" 
                             style="width: 40px; height: 40px; font-size: 0.8rem; cursor: pointer;"
                             title="Seat @seat.SeatNumber (@seat.Type)">
                            @seat.SeatNumber
                        </div>
                        
                        <form asp-action="Delete" method="post" class="position-absolute" style="top: -5px; right: -5px;">
                             <input type="hidden" name="id" value="@seat.Id" />
                             <input type="hidden" name="hallId" value="@seat.HallId" />
                             <button type="submit" class="btn btn-sm btn-danger p-0" 
                                     style="width: 15px; height: 15px; line-height: 10px; font-size: 10px; border-radius: 50%;"
                                     onclick="return confirm('Remove seat @seat.RowNumber-@seat.SeatNumber?');">
                                 &times;
                             </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
    
    <div class="mt-4 text-center">
        <span class="badge bg-success me-2">Regular Seat</span>
        <span class="badge bg-warning text-dark">Premium Seat</span>
    </div>
}