@model Core.DTOs.SessionDTO
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Create Session";
}

<link rel="stylesheet" href="~/css/admin-base.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/admin-hall.css" asp-append-version="true"/>

<div class="container py-5">
    <div class="mb-4 d-flex justify-content-between align-items-end">
        <div>
            <h2 class="fw-bold m-0 text-white">Create New Session</h2>
            <p class="text-muted small m-0">Schedule a movie screening in a cinema hall</p>
        </div>
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left"></i> Back to Sessions
        </a>
    </div>

    <div class="create-card">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <form asp-action="Create" method="post" id="sessionForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                    <h5 class="section-title">
                        <i class="bi bi-calendar-event me-2 text-success"></i>Session Details
                    </h5>

                    <div class="row g-4">
                        <div class="col-md-6 mb-2">
                            <label asp-for="MovieId" class="form-label">Movie</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent text-success border-end-0">
                                    <i class="bi bi-film"></i>
                                </span>
                                <select asp-for="MovieId" class="form-select select2-admin" id="movieSelect"
                                        asp-items="ViewBag.Movies">
                                    <option value="">Select Movie...</option>
                                </select>
                            </div>
                            <span asp-validation-for="MovieId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-2">
                            <label asp-for="HallId" class="form-label">Cinema Hall</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent text-success border-end-0">
                                    <i class="bi bi-door-closed"></i>
                                </span>
                                <select asp-for="HallId" class="form-select select2-admin" id="hallSelect"
                                        asp-items="ViewBag.Halls">
                                    <option value="">Select Hall...</option>
                                </select>
                            </div>
                            <span asp-validation-for="HallId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="StartTime" class="form-label">Start Time</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent text-success border-end-0">
                                    <i class="bi bi-clock"></i>
                                </span>
                                <input asp-for="StartTime" class="form-control" id="startTimeInput"
                                       type="datetime-local"/>
                            </div>
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="EndTime" class="form-label">End Time</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent text-success border-end-0">
                                    <i class="bi bi-clock-history"></i>
                                </span>
                                <input asp-for="EndTime" class="form-control" id="endTimeInput" type="datetime-local"/>
                            </div>
                            <span asp-validation-for="EndTime" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="BasePrice" class="form-label">Base Ticket Price</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent text-success border-end-0">
                                    <i class="bi bi-currency-dollar"></i>
                                </span>
                                <input asp-for="BasePrice" class="form-control" placeholder="0.00" id="priceInput"
                                       type="number" step="0.01"/>
                            </div>
                            <span asp-validation-for="BasePrice" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-5 pt-3 border-top"
                         style="border-color: var(--admin-border) !important;">
                        <button type="submit" class="btn-action btn-create shadow-sm">
                            <i class="bi bi-plus-circle"></i> Create Session
                        </button>
                        <a asp-action="Index" class="btn-action btn-cancel">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/session-form.js" asp-append-version="true"></script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}