@using Core.Constants
@using Core.Enums
@model Core.DTOs.SessionDTO
@{
    ViewData["Title"] = "Session Info";
    var hallType = ViewBag.HallType is HallType type ? type : HallType.Standard;
    var posterUrl = ViewBag.PosterUrl; // Получаем постер

    string badgeClass = hallType switch
    {
        HallType.IMAX => "border-primary text-primary",
        HallType.VIP => "border-warning text-warning",
        _ => "border-danger text-danger"
    };
}

<div class="session-hero" style="background-image: linear-gradient(to bottom, rgba(0,0,0,0.7), #000), url('@posterUrl');">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a asp-controller="Sessions" asp-action="Schedule" class="text-danger text-decoration-none fw-bold">Schedule</a>
                </li>
                <li class="breadcrumb-item active text-white-50" aria-current="page">Booking</li>
            </ol>
        </nav>
        <h1 class="display-4 fw-bold text-white shadow-text">@ViewBag.MovieName</h1>
    </div>
</div>

<div class="container mb-5" style="margin-top: -60px;">
    <div class="card bg-dark text-white border-secondary shadow-lg overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <div class="row">
                <div class="col-md-8">
                    <div class="d-flex flex-wrap gap-4 mb-5">
                        <div class="text-center p-3 bg-black rounded-4 border @badgeClass" style="min-width: 120px;">
                            <div class="small text-muted text-uppercase fw-semibold mb-1">Hall Type</div>
                            <div class="fw-bold fs-5">@hallType.ToString().ToUpper()</div>
                        </div>

                        <div class="text-center p-3 bg-black rounded-4 border border-secondary" style="min-width: 120px;">
                            <div class="small text-muted text-uppercase fw-semibold mb-1">Starts At</div>
                            <div class="fw-bold fs-5">@Model.StartTime.ToString("HH:mm")</div>
                        </div>

                        <div class="text-center p-3 bg-black rounded-4 border border-secondary" style="min-width: 120px;">
                            <div class="small text-muted text-uppercase fw-semibold mb-1">Base Price</div>
                            <div class="fw-bold fs-5 text-success">@Model.BasePrice ₴</div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <h5 class="text-muted text-uppercase small fw-bold mb-3">Hall Details</h5>
                        <p class="fs-5"><i class="bi bi-geo-alt-fill text-danger me-2"></i> @ViewBag.HallName</p>
                    </div>

                    @if (User.IsInRole(Roles.Admin))
                    {
                        <div class="alert alert-dark border-secondary d-inline-flex align-items-center mb-4 p-3 shadow-sm">
                            <i class="bi bi-shield-lock-fill text-warning me-3 fs-4"></i>
                            <div>
                                <div class="fw-bold">Administrator Access</div>
                                <div class="small text-muted">You can modify or cancel this session.</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4 rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-pencil-square me-2"></i>Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger px-4 rounded-pill fw-bold">
                                <i class="bi bi-trash me-2"></i>Delete
                            </a>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Tickets" asp-action="Book" asp-route-sessionId="@Model.Id"
                           class="btn btn-danger btn-lg px-5 py-3 fw-bold rounded-pill shadow-lg border-0 btn-book-seats">
                            CHOOSE YOUR SEATS <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Стиль для "Героя" */
    .session-hero {
        min-height: 400px;
        background-size: cover;
        background-position: center 25%;
        display: flex;
        align-items: center;
        padding-bottom: 60px;
    }

    .shadow-text {
        text-shadow: 2px 4px 10px rgba(0,0,0,0.8);
    }

    .btn-book-seats {
        background: linear-gradient(45deg, #dc3545, #b02a37);
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-book-seats:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(220, 53, 69, 0.4);
            color: white;
        }

    .breadcrumb-item + .breadcrumb-item::before {
        color: rgba(255,255,255,0.5);
    }
</style>