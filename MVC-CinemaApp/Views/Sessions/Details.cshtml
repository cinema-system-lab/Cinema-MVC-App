@using Core.Enums
@model Core.DTOs.SessionDTO
@{
    ViewData["Title"] = "Session Info";
    var hallType = ViewBag.HallType is HallType type ? type : HallType.Standard;
    var posterUrl = ViewBag.PosterUrl;

    string badgeClass = hallType switch
    {
        HallType.IMAX => "border-primary text-primary",
        HallType.VIP => "border-warning text-warning",
        _ => "border-danger text-danger"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/client/session-details.css" asp-append-version="true" />
}

<div class="session-hero" style="background-image: linear-gradient(to bottom, rgba(0,0,0,0.8), #000), url('@posterUrl');">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a asp-controller="Sessions" asp-action="Schedule" class="text-danger text-decoration-none fw-bold small text-uppercase">Schedule</a>
                </li>
                <li class="breadcrumb-item active text-white-50 small text-uppercase" aria-current="page">Booking</li>
            </ol>
        </nav>
        <h1 class="display-3 fw-bold text-white shadow-text">@ViewBag.MovieName</h1>
        <p class="text-white-50 fs-5"><i class="bi bi-geo-alt-fill text-danger me-2"></i> @ViewBag.HallName</p>
    </div>
</div>

<div class="container mb-5" style="margin-top: -80px;">
    <div class="card bg-dark text-white border-0 shadow-lg overflow-hidden" style="border-radius: 20px;">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-lg-12">
                    <div class="d-flex flex-wrap gap-3 gap-md-4 mb-5 justify-content-start">

                        <div class="text-center p-3 bg-black rounded-4 border @badgeClass shadow-sm" style="min-width: 130px;">
                            <div class="small text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.7rem;">Technology</div>
                            <div class="fw-bold fs-5">@hallType.ToString().ToUpper()</div>
                        </div>

                        <div class="text-center p-3 bg-black rounded-4 border border-secondary shadow-sm" style="min-width: 130px;">
                            <div class="small text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.7rem;">Starts At</div>
                            <div class="fw-bold fs-4 text-primary">@Model.StartTime.ToString("HH:mm")</div>
                        </div>

                        <div class="text-center p-3 bg-black rounded-4 border border-secondary shadow-sm" style="min-width: 130px;">
                            <div class="small text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.7rem;">Date</div>
                            <div class="fw-bold fs-5 text-white">@Model.StartTime.ToString("dd MMM")</div>
                        </div>

                        <div class="text-center p-3 bg-black rounded-4 border border-success shadow-sm" style="min-width: 130px;">
                            <div class="small text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.7rem;">Price from</div>
                            <div class="fw-bold fs-5 text-success">@Model.BasePrice ₴</div>
                        </div>

                    </div>

                    <hr class="border-secondary mb-5 opacity-25">

                    <div class="text-center text-md-start">
                        <a asp-controller="Tickets" asp-action="Book" asp-route-sessionId="@Model.Id"
                           class="btn btn-danger btn-lg px-5 py-3 fw-bold rounded-pill shadow-lg border-0 btn-book-seats scale-hover">
                            CHOOSE YOUR SEATS <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                        <p class="text-muted mt-3 small">
                            <i class="bi bi-info-circle me-1"></i> You will be able to select specific rows and seats on the next step.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>