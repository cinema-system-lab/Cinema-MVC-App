@using Cinema_MVC_App.Models;
@using System.Linq
@model SessionsListVM

@{
    ViewData["Title"] = "Available Sessions";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-white fw-bold mb-0">Sessions List</h1>
            <p class="text-muted mb-0">Full list of available movie screenings</p>
        </div>
        <a asp-action="Schedule" class="btn btn-outline-danger rounded-pill px-4">
            <i class="bi bi-calendar3 me-2"></i>View Schedule
        </a>
    </div>

    @if (Model?.Sessions == null || !Model.Sessions.Any())
    {
        <div class="bg-dark rounded-4 p-5 text-center border border-secondary">
            <i class="bi bi-camera-reels text-muted fs-1 d-block mb-3"></i>
            <h4 class="text-white">No sessions found</h4>
            <p class="text-muted">Check back later for new screenings.</p>
        </div>
    }
    else
    {
        <div class="card bg-dark border-secondary shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="bg-black text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Movie</th>
                            <th class="py-3">Hall</th>
                            <th class="py-3">Start Time</th>
                            <th class="py-3">Price</th>
                            <th class="text-end pe-4 py-3">Booking</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model.Sessions.OrderBy(s => s.StartTime))
                        {
                            Model.Movies.TryGetValue(session.MovieId, out var movie);
                            Model.Halls.TryGetValue(session.HallId, out var hall);

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        @if (movie != null)
                                        {
                                            <img src="@movie.PosterUrl" alt="@movie.Title"
                                                 class="rounded-2 me-3" style="width: 40px; height: 60px; object-fit: cover;">
                                            <span class="fw-bold text-white">@movie.Title</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted italic">Unknown Movie</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary opacity-75">@(hall?.Name ?? "Standard Hall")</span>
                                </td>
                                <td>
                                    <div class="text-white">@session.StartTime.ToString("dd MMM, HH:mm")</div>
                                    <small class="text-muted">Ends @session.EndTime.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <span class="text-success fw-bold">@session.BasePrice ₴</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@session.Id"
                                       class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm">
                                        Tickets <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>