@using Core.Constants
@using Cinema_MVC_App.Models;
@using System.Linq


@{
    ViewData["Title"] = "Sessions Management";
}

<h2>Sessions</h2>

@if (User.IsInRole(Roles.Admin))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Session</a>
    </p>
}

@if (Model?.Sessions == null || Model.Sessions.Count == 0)
{
    <p>No sessions found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Movie</th>
                <th>Hall</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Base Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var session in Model.Sessions)
            {
                <tr>
                    <td>
                        @{
                            Core.DTOs.MovieDTO movie = null;
                            var hasMovie = Model.Movies.TryGetValue(session.MovieId, out movie);
                        }
                        @(hasMovie? movie.Title: "Unknown Movie")
                    </td>

                    <td>
                        @{
                            Core.DTOs.HallDTO hall = null;
                            var hasHall = Model.Halls.TryGetValue(session.HallId, out hall);
                        }
                        @(hasHall? hall.Name: "Unknown Hall")
                    </td>

                    <td>@session.StartTime.ToString("g")</td>
                    <td>@session.EndTime.ToString("g")</td>
                    <td>@session.BasePrice ₴</td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="Details" asp-route-id="@session.Id" class="btn btn-info btn-sm">Details</a>
                            @if (User.IsInRole(Roles.Admin))
                            {
                                <a asp-action="Edit" asp-route-id="@session.Id" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@session.Id" class="btn btn-danger btn-sm">Delete</a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}