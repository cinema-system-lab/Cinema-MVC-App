@using Core.Constants
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-ticket-perforated-fill text-danger"></i> CINEMA APP
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navbarNav">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Movies" asp-action="Index">Movies</a></li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Sessions" asp-action="Schedule">Schedule</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Orders" asp-action="">My orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Privacy" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-question-circle me-1"></i>Help
                            </a>
                        </li>

                        @* Навигация для Админа *@
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning" href="#" data-bs-toggle="dropdown">Admin Management</a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow-lg">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Halls" asp-action="Index">Halls</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Sessions" asp-action="Index">Manage Sessions</a></li>
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    @* Ссылка на будущую Area *@
                                    <li><a class="dropdown-item text-danger fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Dashboard</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <div class="d-flex align-items-center bg-dark rounded-pill px-3 py-1 border border-secondary">
                                    <span class="small me-2 text-white-50">@User.Identity.Name</span>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0 ms-1 fw-bold text-decoration-none">Logout</button>
                                    </form>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li class="nav-item">
                                <a class="btn btn-danger btn-sm rounded-0 px-4 fw-bold w-100" asp-area="" asp-controller="Account" asp-action="Register">Join Us</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="mt-5 py-4 border-top border-secondary">
        <div class="container text-center text-muted">
            <p class="small mb-0">&copy; @DateTime.Now.Year Cinema App. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>