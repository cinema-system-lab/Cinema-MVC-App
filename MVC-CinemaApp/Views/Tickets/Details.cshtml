@model Core.DTOs.TicketDTO

<h2>Ticket Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Order ID</dt>
        <dd class="col-sm-10">@Model.OrderId</dd>

        <dt class="col-sm-2">Movie</dt>
        <dd class="col-sm-10">@Model.MovieTitle</dd>

        <dt class="col-sm-2">Hall</dt>
        <dd class="col-sm-10">@Model.HallName</dd>

        <dt class="col-sm-2">Start Time</dt>
        <dd class="col-sm-10">@Model.StartTime.ToString("f")</dd>

        <dt class="col-sm-2">Seat</dt>
        <dd class="col-sm-10">Row @Model.RowNumber, Seat @Model.SeatNumber</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Price.ToString("C")</dd>
    </dl>
</div>

<p>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</p>