@model Core.DTOs.TicketDTO

@{
    ViewData["Title"] = "Your Ticket";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="ticket-card bg-white text-dark shadow-lg overflow-hidden" style="border-radius: 20px;">
                <div class="bg-danger p-4 text-white text-center position-relative">
                    <div class="small text-uppercase opacity-75 mb-1">Movie Ticket</div>
                    <h3 class="fw-bold text-uppercase mb-0">@Model.MovieTitle</h3>
                    <div class="position-absolute start-0 top-100 translate-middle-y bg-dark" style="width: 20px; height: 20px; border-radius: 50%; margin-left: -10px;"></div>
                    <div class="position-absolute end-0 top-100 translate-middle-y bg-dark" style="width: 20px; height: 20px; border-radius: 50%; margin-right: -10px;"></div>
                </div>

                <div class="p-4 bg-light border-bottom border-2 border-dashed border-secondary">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="small text-muted text-uppercase">Date & Time</div>
                            <div class="fw-bold text-dark">@Model.StartTime.ToString("dd MMM yyyy")</div>
                            <div class="fw-bold text-danger fs-5">@Model.StartTime.ToString("HH:mm")</div>
                        </div>
                        <div class="col-6 text-end">
                            <div class="small text-muted text-uppercase">Cinema Hall</div>
                            <div class="fw-bold text-dark">@Model.HallName</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-muted text-uppercase">Row</div>
                            <div class="fw-bold fs-4 text-dark">@Model.RowNumber</div>
                        </div>
                        <div class="col-6 text-end">
                            <div class="small text-muted text-uppercase">Seat</div>
                            <div class="fw-bold fs-4 text-dark">@Model.SeatNumber</div>
                        </div>
                    </div>
                </div>

                <div class="p-4 bg-white text-center">
                    <div class="mb-3">
                        <div class="barcode bg-dark mx-auto mb-2" style="height: 50px; width: 80%; opacity: 0.8;"></div>
                        <small class="text-muted text-uppercase ls-wide">Order: #@Model.OrderId</small>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <span class="text-muted">Paid Amount</span>
                        <span class="fw-bold fs-4 text-success">@Model.Price ₴</span>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-light flex-grow-1 rounded-pill">
                    <i class="bi bi-arrow-left me-2"></i>My Tickets
                </a>
                <button onclick="window.print()" class="btn btn-secondary rounded-pill">
                    <i class="bi bi-printer"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .barcode {
        background: repeating-linear-gradient(90deg, #000, #000 2px, #fff 2px, #fff 4px);
    }

    .ls-wide {
        letter-spacing: 2px;
    }

    .ticket-card {
        border: 1px solid rgba(0,0,0,0.1);
    }

    @@media print {
        .btn, .bg-dark {
            display: none !important;
        }

        body {
            background: white !important;
        }

        .ticket-card {
            shadow: none !important;
            border: 1px solid #ccc;
        }
    }
</style>